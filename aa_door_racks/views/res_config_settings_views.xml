<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.door.racks</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='operations_setting_container']" position="after">
                <block title="Door Racks" name="aa_door_racks_setting_container">
                    <setting id="aa_rack_stack" string="Stack height" help="Panel thickness, the board between doors, and the room the forklift needs above a stack">
                        <div class="row"><label for="aa_rack_panel_thickness" class="col-lg-6"/><field name="aa_rack_panel_thickness"/></div>
                        <div class="row"><label for="aa_rack_spacer" class="col-lg-6"/><field name="aa_rack_spacer"/></div>
                        <div class="row"><label for="aa_rack_lift_room" class="col-lg-6"/><field name="aa_rack_lift_room"/></div>
                    </setting>
                    <setting id="aa_rack_arms" string="Arms per door" help="Up to this length a door rests on two arms; longer needs three">
                        <div class="row"><label for="aa_rack_two_arm_max" class="col-lg-6"/><field name="aa_rack_two_arm_max"/></div>
                        <div class="row"><label for="aa_rack_fallback_max" class="col-lg-6"/><field name="aa_rack_fallback_max"/></div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
