<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- BESIDE THE SUPPLIER'S REFERENCE, NEVER IN PLACE OF IT (owner's
       standing rule: supplier codes stay in Internal Reference). -->

  <!-- Product form: shown always, unlike Odoo's Reference which hides once
       a product has variants - the base is what the variants share. -->
  <record id="view_template_form_aa_part" model="ir.ui.view">
    <field name="name">product.template.form.aa.part</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_only_form_view"/>
    <field name="arch" type="xml">
      <field name="default_code" position="before">
        <field name="aa_part_base" invisible="not aa_part_base"/>
      </field>
    </field>
  </record>

  <record id="view_template_list_aa_part" model="ir.ui.view">
    <field name="name">product.template.list.aa.part</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_tree_view"/>
    <field name="arch" type="xml">
      <field name="name" position="before">
        <field name="aa_part_base"/>
      </field>
    </field>
  </record>

  <!-- Variant form and list: the exact number, letter included. -->
  <record id="view_product_form_aa_part" model="ir.ui.view">
    <field name="name">product.product.form.aa.part</field>
    <field name="model">product.product</field>
    <field name="inherit_id" ref="product.product_normal_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='default_code']" position="before">
        <field name="aa_part_number"/>
      </xpath>
    </field>
  </record>

  <record id="view_product_list_aa_part" model="ir.ui.view">
    <field name="name">product.product.list.aa.part</field>
    <field name="model">product.product</field>
    <field name="inherit_id" ref="product.product_product_tree_view"/>
    <field name="arch" type="xml">
      <field name="default_code" position="before">
        <field name="aa_part_number"/>
      </field>
    </field>
  </record>

  <!-- FOUND BY TYPING IT IN THE BOX. The search box searches its FIRST field
       on Enter (the PO-number lesson in CLAUDE.md), so the part number joins
       Odoo's own Product facet rather than sitting at the bottom of a
       dropdown nobody opens; it is also its own field for an exact hunt. -->
  <record id="view_template_search_aa_part" model="ir.ui.view">
    <field name="name">product.template.search.aa.part</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_search_view"/>
    <field name="arch" type="xml">
      <field name="name" position="attributes">
        <attribute name="filter_domain">['|', '|', '|', '|', '|', ('aa_part_base', 'ilike', self), ('product_variant_ids.aa_part_number', 'ilike', self), ('default_code', 'ilike', self), ('product_variant_ids.default_code', 'ilike', self), ('name', 'ilike', self), ('barcode', 'ilike', self)]</attribute>
      </field>
      <field name="name" position="after">
        <field name="aa_part_base" string="AA Part #"
               filter_domain="['|', ('aa_part_base', 'ilike', self), ('product_variant_ids.aa_part_number', 'ilike', self)]"/>
      </field>
    </field>
  </record>

  <record id="view_product_search_aa_part" model="ir.ui.view">
    <field name="name">product.product.search.aa.part</field>
    <field name="model">product.product</field>
    <field name="inherit_id" ref="product.product_search_form_view"/>
    <field name="arch" type="xml">
      <field name="name" position="attributes">
        <attribute name="filter_domain">['|', '|', '|', ('aa_part_number', 'ilike', self), ('default_code', 'ilike', self), ('name', 'ilike', self), ('barcode', 'ilike', self)]</attribute>
      </field>
      <field name="name" position="after">
        <field name="aa_part_number"/>
      </field>
    </field>
  </record>
</odoo>
