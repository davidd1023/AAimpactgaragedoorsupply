<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Floor / Rack / Boxes: one table each, per wire and I.D. -->
    <record id="view_aa_spring_place_summary_list" model="ir.ui.view">
        <field name="name">aa.spring.place.summary.list</field>
        <field name="model">aa.spring.place.summary</field>
        <field name="arch" type="xml">
            <list string="Spring Inventory" create="0" edit="0" delete="0">
                <field name="place" column_invisible="context.get('aa_all_places')"/>
                <field name="box_id" optional="show"/>
                <field name="inside_diameter"/>
                <field name="wire"/>
                <field name="pairs" sum="Pairs"/>
                <field name="l_pcs" sum="LH"/>
                <field name="r_pcs" sum="RH"/>
                <field name="l_in" sum="LH (in)" optional="show"/>
                <field name="r_in" sum="RH (in)" optional="show"/>
                <field name="l_longest" optional="hide"/>
                <field name="r_longest" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_aa_spring_place_summary_search" model="ir.ui.view">
        <field name="name">aa.spring.place.summary.search</field>
        <field name="model">aa.spring.place.summary</field>
        <field name="arch" type="xml">
            <search>
                <field name="wire"/>
                <field name="inside_diameter"/>
                <field name="box_id"/>
                <filter name="id_2625" string='2 5/8"' domain="[('inside_diameter_num', '=', 2.625)]"/>
                <filter name="id_375" string='3 3/4"' domain="[('inside_diameter_num', '=', 3.75)]"/>
                <filter name="id_525" string='5 1/4"' domain="[('inside_diameter_num', '=', 5.25)]"/>
                <group>
                    <filter name="group_place" string="Place" context="{'group_by': 'place'}"/>
                    <filter name="group_id" string="I.D." context="{'group_by': 'inside_diameter'}"/>
                    <filter name="group_box" string="Box" context="{'group_by': 'box_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_aa_spring_places" model="ir.actions.act_window">
        <field name="name">Floor / Rack / Boxes</field>
        <field name="res_model">aa.spring.place.summary</field>
        <field name="view_mode">list</field>
        <field name="context">{'aa_all_places': 1, 'search_default_group_place': 1, 'search_default_group_id': 1}</field>
        <field name="help" type="html"><p>Open Floor, Rack or Boxes to see what is in each, by I.D.
            Springs are cut from the Rack first, then the Floor, and the Boxes last.</p></field>
    </record>

    <!-- Spring boxes -->
    <record id="view_aa_spring_box_list" model="ir.ui.view">
        <field name="name">aa.spring.box.list</field>
        <field name="model">aa.spring.box</field>
        <field name="arch" type="xml">
            <list string="Spring Boxes" decoration-muted="state == 'closed'"
                  decoration-warning="state == 'open' and is_empty">
                <field name="number"/>
                <field name="contents_label"/>
                <field name="l_coils"/>
                <field name="r_coils"/>
                <field name="date" optional="show"/>
                <field name="note" optional="show"/>
                <field name="is_empty" column_invisible="1"/>
                <field name="state" widget="badge" decoration-success="state == 'open'"/>
            </list>
        </field>
    </record>

    <record id="view_aa_spring_box_form" model="ir.ui.view">
        <field name="name">aa.spring.box.form</field>
        <field name="model">aa.spring.box</field>
        <field name="arch" type="xml">
            <form string="Spring Box">
                <header>
                    <button name="action_add_coils" type="object" string="Add Coils" class="btn-primary"
                            invisible="not id or state != 'open'"/>
                    <button name="action_move_to_floor" type="object" string="Move to Floor"
                            invisible="not id or state != 'open' or is_empty"/>
                    <button name="action_remove" type="object" string="Remove Box"
                            invisible="not id or state != 'open' or not is_empty"
                            confirm="Remove this empty box?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_coils" type="object" class="oe_stat_button" icon="fa-cubes"
                                invisible="not id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Coils</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="number" readonly="state != 'open'"/>
                            <field name="date"/>
                            <field name="note"/>
                        </group>
                        <group>
                            <field name="l_coils"/>
                            <field name="r_coils"/>
                            <field name="location_id" groups="stock.group_stock_multi_locations"/>
                            <field name="is_empty" invisible="1"/>
                        </group>
                    </group>
                    <field name="content_ids" invisible="not id">
                        <list create="0" edit="0" delete="0">
                            <field name="inside_diameter"/>
                            <field name="wire"/>
                            <field name="l_pcs" string="LH Coils" sum="LH"/>
                            <field name="r_pcs" string="RH Coils" sum="RH"/>
                            <field name="pairs" sum="Pairs"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_aa_spring_box_search" model="ir.ui.view">
        <field name="name">aa.spring.box.search</field>
        <field name="model">aa.spring.box</field>
        <field name="arch" type="xml">
            <search>
                <field name="number"/>
                <field name="note"/>
                <filter name="open" string="In Stock" domain="[('state', '=', 'open')]"/>
                <filter name="closed" string="Removed" domain="[('state', '=', 'closed')]"/>
            </search>
        </field>
    </record>

    <record id="action_aa_spring_boxes" model="ir.actions.act_window">
        <field name="name">Spring Boxes</field>
        <field name="res_model">aa.spring.box</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a box of spring coils</p>
            <p>Give it a number, then use Add Coils to enter what is inside.</p>
        </field>
    </record>

    <!-- Add coils -->
    <record id="view_aa_spring_box_add_form" model="ir.ui.view">
        <field name="name">aa.spring.box.add.form</field>
        <field name="model">aa.spring.box.add</field>
        <field name="arch" type="xml">
            <form string="Add Coils">
                <field name="box_id" invisible="1"/>
                <p>One line per I.D. and wire. Each coil is 84" unless you change the length.</p>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="inside_diameter"/>
                        <field name="wire"/>
                        <field name="l_qty" sum="LH"/>
                        <field name="r_qty" sum="RH"/>
                        <field name="length" optional="hide"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Add to Box" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Move to floor -->
    <record id="view_aa_spring_box_move_form" model="ir.ui.view">
        <field name="name">aa.spring.box.move.form</field>
        <field name="model">aa.spring.box.move</field>
        <field name="arch" type="xml">
            <form string="Move to Floor">
                <field name="box_id" invisible="1"/>
                <p>How many coils of each go down to the floor.</p>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="product_id" column_invisible="1" force_save="1"/>
                        <field name="inside_diameter"/>
                        <field name="wire"/>
                        <field name="hand"/>
                        <field name="available" force_save="1"/>
                        <field name="qty"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Move to Floor" class="btn-primary"/>
                    <button name="action_all" type="object" string="Move Everything"
                            confirm="Move every coil in this box to the floor?"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Inventory > Springs -->
    <menuitem id="menu_aa_spring_places" name="Floor / Rack / Boxes" parent="menu_aa_springs"
              action="action_aa_spring_places" sequence="12"/>
    <menuitem id="menu_aa_spring_boxes" name="Spring Boxes" parent="menu_aa_springs"
              action="action_aa_spring_boxes" sequence="15"/>

</odoo>
