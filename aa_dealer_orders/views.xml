<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_aa_dealer" model="ir.ui.view">
        <field name="name">res.partner.form.aa.dealer</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <group name="container_row_2" position="inside">
                <group name="aa_dealer" string="Preferred Dealer" invisible="not is_company and parent_id">
                    <field name="aa_order_on_account"/>
                    <field name="aa_dealer_margin" invisible="not aa_order_on_account"/>
                    <field name="aa_dealer_pricelist_id" invisible="not aa_dealer_pricelist_id"/>
                </group>
            </group>
        </field>
    </record>

    <record id="product_template_form_aa_dealer" model="ir.ui.view">
        <field name="name">product.template.form.aa.dealer</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- A GROUP OF OUR OWN, WITH A HEADING, because group[@name='sale']
                 is not a field group at all: its children are the Upsell,
                 eCommerce Shop and eCommerce Media GROUPS, so a bare field
                 dropped inside it renders as an unlabelled checkbox stranded
                 under Add Media. The Dealer Quick Order tick had been sitting
                 there unlabelled since the day it was written, and the Custom
                 Kit tick joined it - which is how the owner came to be looking
                 at "two random boxes in the ecommerce media section" without
                 being able to tell which was which (2026-10-20). -->
            <xpath expr="//page[@name='sales']//group[@name='sale']" position="inside">
                <group string="AA Impact" name="aa_product_options">
                    <field name="aa_dealer_quick_order"/>
                    <field name="aa_custom_kit_part"/>
                    <field name="aa_custom_kit" groups="base.group_no_one"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_aa_dealer" model="ir.ui.view">
        <field name="name">sale.order.form.aa.dealer</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <widget name="web_ribbon" title="Dealer Quick Order" bg_color="text-bg-info"
                        invisible="not aa_dealer_quick_order"/>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_aa_dealer" model="ir.ui.view">
        <field name="name">sale.order.search.aa.dealer</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_sale_orders_filter']" position="after">
                <filter string="Dealer Quick Orders" name="aa_dealer_quick_order"
                        domain="[('aa_dealer_quick_order', '=', True)]"/>
            </xpath>
        </field>
    </record>
  <record id="view_product_template_search_aa_custom_kit" model="ir.ui.view">
    <field name="name">product.template.search.aa.custom.kit</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_search_view"/>
    <field name="arch" type="xml">
      <xpath expr="//search" position="inside">
        <filter name="aa_custom_kit_part" string="Offered in Custom Kit"
                domain="[('aa_custom_kit_part', '=', True)]"/>
      </xpath>
    </field>
  </record>

</odoo>
