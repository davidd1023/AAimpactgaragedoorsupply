<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- WHAT IS BELOW ITS MINIMUM, worst first.
       Owner, 2026-10-29: "we need to make a warning when an item is below its
       minimum so that we can make a reorder of that product."

       SORTED BY HOW FAR BELOW. 97 of the 157 parts he set a minimum for are
       already under it, because the minimums cover 180 doors - so a screen
       with no order to it is 97 rows of undifferentiated alarm, and the top
       of this one is the list to ring the supplier about. -->
  <record id="view_aa_stock_minmax_list" model="ir.ui.view">
    <field name="name">aa.stock.minmax.list</field>
    <field name="model">aa.stock.minmax</field>
    <field name="arch" type="xml">
      <list string="Min / Max Levels" create="0" delete="0" edit="0"
            default_order="short_by desc"
            decoration-danger="status == 'below'"
            decoration-muted="status == 'untracked'">
        <field name="code" string="Part #"/>
        <field name="product_id" string="Part"/>
        <field name="categ_id" optional="show"/>
        <field name="on_hand" sum="On Hand"/>
        <field name="min_qty" string="Min"/>
        <!-- SHOWN THOUGH IT IS EMPTY EVERYWHERE, on purpose. He said "the
             list doesn't currently show the max so we can just worry about
             the minimum for now" - so the column exists and filling it is
             typing, not another deploy. -->
        <field name="max_qty" string="Max"/>
        <field name="short_by" string="Short By" sum="Short By"/>
        <field name="uom_name" string="Unit" optional="show"/>
        <field name="vendor_id" optional="show"/>
        <field name="status" widget="badge"
               decoration-danger="status == 'below'"
               decoration-success="status == 'ok'"
               decoration-muted="status == 'untracked'"/>
        <!-- A REPORT CANNOT BE TYPED INTO - it is a database view - and the
             minimum he disagrees with is the one he wants to change there and
             then. -->
        <button name="action_edit_levels" type="object" string="Levels"
                icon="fa-pencil" title="Change this part's min / max"/>
      </list>
    </field>
  </record>

  <record id="view_aa_stock_minmax_search" model="ir.ui.view">
    <field name="name">aa.stock.minmax.search</field>
    <field name="model">aa.stock.minmax</field>
    <field name="arch" type="xml">
      <search>
        <field name="product_id"/>
        <field name="code"/>
        <field name="vendor_id"/>
        <filter name="below" string="Below Minimum"
                domain="[('status', '=', 'below')]"/>
        <filter name="tracked" string="Has a Minimum"
                domain="[('status', 'in', ('below', 'ok'))]"/>
        <filter name="untracked" string="No Minimum Set"
                domain="[('status', '=', 'untracked')]"/>
        <separator/>
        <filter name="has_vendor" string="Has a Vendor"
                domain="[('vendor_id', '!=', False)]"/>
        <group>
          <filter name="group_status" string="Status"
                  context="{'group_by': 'status'}"/>
          <filter name="group_categ" string="Category"
                  context="{'group_by': 'categ_id'}"/>
          <filter name="group_vendor" string="Vendor"
                  context="{'group_by': 'vendor_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_aa_stock_minmax" model="ir.actions.act_window">
    <field name="name">Min / Max Levels</field>
    <field name="res_model">aa.stock.minmax</field>
    <field name="view_mode">list</field>
    <!-- OPENS ON WHAT IS SHORT. He asked to "easily see the max and min of
         each item" and every part is one click away on the Status filters -
         but the question the screen exists to answer is what needs ordering,
         so that is what it opens on. -->
    <field name="context">{'search_default_below': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Nothing is below its minimum.</p>
      <p>
        Clear the "Below Minimum" filter to see every part with its minimum
        and maximum. The levels are Odoo's own reordering rules, so anything
        listed here can be ordered from Inventory &gt; Operations &gt;
        Replenishment.
      </p>
    </field>
  </record>

  <!-- IN INVENTORY > REPORTING, where he asked for it. -->
  <menuitem id="menu_aa_stock_minmax"
            name="Min / Max Levels"
            parent="stock.menu_warehouse_report"
            action="action_aa_stock_minmax"
            sequence="25"/>

</odoo>
