<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ============================================================
       COVERAGE BY FAMILY: "how far do my tracks go", one row each.
       ============================================================ -->
  <record id="view_aa_coverage_family_list" model="ir.ui.view">
    <field name="name">aa.order.coverage.family.list</field>
    <field name="model">aa.order.coverage.family</field>
    <field name="arch" type="xml">
      <list string="Coverage by Family" create="0" delete="0" edit="0"
            decoration-success="short_order_count == 0"
            decoration-bf="is_all">
        <field name="is_all" column_invisible="1"/>
        <field name="name" string="Family"/>
        <field name="order_count"/>
        <field name="covered_count"/>
        <field name="covered_upto"/>
        <field name="first_short" decoration-danger="first_short"/>
        <field name="first_short_parts"/>
        <field name="short_order_count"/>
        <button name="action_open_lines" type="object" string="Orders"
                icon="fa-list" title="Open the orders with this family's parts"/>
      </list>
    </field>
  </record>

  <record id="action_aa_coverage_family" model="ir.actions.act_window">
    <field name="name">Coverage by Family</field>
    <field name="res_model">aa.order.coverage.family</field>
    <field name="view_mode">list</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">No open orders.</p>
    </field>
  </record>

  <!-- ============================================================
       ORDER COVERAGE: every open order, oldest first, every part.
       ============================================================ -->
  <record id="view_aa_coverage_line_list" model="ir.ui.view">
    <field name="name">aa.order.coverage.line.list</field>
    <field name="model">aa.order.coverage.line</field>
    <field name="arch" type="xml">
      <list string="Order Coverage" create="0" delete="0" edit="0"
            decoration-danger="is_short"
            decoration-success="not is_short">
        <header>
          <button name="action_open_coverage" type="object" string="Refresh"
                  icon="fa-refresh" display="always"/>
        </header>
        <field name="is_short" column_invisible="1"/>
        <field name="seq" optional="hide"/>
        <field name="wo_number"/>
        <field name="po_number"/>
        <field name="partner_id" optional="show"/>
        <field name="pickup_date" optional="show"/>
        <field name="family_id" optional="show"/>
        <field name="product_id"/>
        <field name="source" optional="hide"/>
        <field name="qty_needed" sum="Needs"/>
        <field name="qty_before"/>
        <field name="qty_short" sum="Short"/>
        <field name="uom_id" optional="hide"/>
      </list>
    </field>
  </record>

  <!-- ORDERS DOWN THE SIDE, FAMILIES ACROSS THE TOP, SHORTAGE IN THE CELLS.
       The first row with a number in a column is where that family runs
       out. -->
  <record id="view_aa_coverage_line_pivot" model="ir.ui.view">
    <field name="name">aa.order.coverage.line.pivot</field>
    <field name="model">aa.order.coverage.line</field>
    <field name="arch" type="xml">
      <pivot string="Order Coverage" disable_linking="0">
        <field name="order_label" type="row"/>
        <field name="family_id" type="col"/>
        <field name="qty_short" type="measure"/>
      </pivot>
    </field>
  </record>

  <record id="view_aa_coverage_line_search" model="ir.ui.view">
    <field name="name">aa.order.coverage.line.search</field>
    <field name="model">aa.order.coverage.line</field>
    <field name="arch" type="xml">
      <search>
        <field name="product_id"/>
        <field name="order_label" string="Order"/>
        <field name="po_number"/>
        <field name="partner_id"/>
        <filter name="short" string="Short" domain="[('is_short', '=', True)]"/>
        <filter name="covered" string="Covered" domain="[('is_short', '=', False)]"/>
        <separator/>
        <filter name="for_order" string="Goes Out With the Order"
                domain="[('source', '=', 'order')]"/>
        <filter name="for_prep" string="Used to Prepare It"
                domain="[('source', '=', 'prep')]"/>
        <group>
          <filter name="group_order" string="Order"
                  context="{'group_by': 'order_label'}"/>
          <filter name="group_family" string="Family"
                  context="{'group_by': 'family_id'}"/>
          <filter name="group_product" string="Part"
                  context="{'group_by': 'product_id'}"/>
        </group>
        <!-- THE FILTER HE ASKED FOR: tick Tracks, or Hinges, and only those
             parts are left on every order. -->
        <searchpanel view_types="list,pivot">
          <field name="family_id" string="Parts" icon="fa-cubes"
                 select="multi" enable_counters="1"/>
        </searchpanel>
      </search>
    </field>
  </record>

  <record id="action_aa_coverage_lines" model="ir.actions.act_window">
    <field name="name">Order Coverage</field>
    <field name="res_model">aa.order.coverage.line</field>
    <field name="view_mode">list,pivot</field>
    <field name="search_view_id" ref="view_aa_coverage_line_search"/>
    <field name="context">{'search_default_group_order': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">No open orders.</p>
      <p>Every open Work Order shows here, oldest first, with what it still
         needs and whether the stock on hand covers it.</p>
    </field>
  </record>

  <!-- ORDERS TO MAKE: the screen he asked for on 2026-11-18 - every open
       order, judged on whichever parts are ticked, and a second tab with
       what we do not have. A client action, because "can we make it" has to
       follow the ticked families and a list view's rows cannot. -->
  <record id="action_aa_order_board" model="ir.actions.client">
    <field name="name">Orders to Make</field>
    <field name="tag">aa_order_coverage.board</field>
  </record>

  <!-- THE ONLY MENU (owner, 2026-11-18: "dejemos solamente el que creamos
       ahora"). Order Coverage and Coverage by Family showed the same figures
       as a raw list and a per-family summary; their menus are gone, the list
       and pivot views stay because the models behind this screen use them. -->
  <menuitem id="menu_aa_order_board"
            name="Orders to Make"
            parent="stock.menu_warehouse_report"
            action="action_aa_order_board"
            sequence="19"/>



</odoo>
