+// WHERE THE ORDER GETS SENT. Kept as a setting rather than written into this
+// file so the page can be pointed at a test build without being edited, and so
+// this public file never has to name the company's systems.
+function saveOdooUrl(){var el=document.getElementById('cfg-odoo');if(!el)return;save({odooUrl:(el.value||'').trim()});renderOdooStatus();}
+function renderOdooStatus(){var url=(load().odooUrl||'').trim();var dot=document.getElementById('dot-odoo'),lbl=document.getElementById('lbl-odoo');if(!dot||!lbl)return;dot.className=url?'status-dot':'status-dot unset';lbl.textContent=url||'Not set';}
+function odooBase(){return (load().odooUrl||'').trim().replace(/\/+$/,'');}
+
+// SEND THE DOOR, NOT THE ANSWER. What crosses to Odoo is the door and its
+// measurements - width, height, track, lift, and the lengths worked out here.
+// Odoo decides for itself which stock item each length is cut from, so this
+// page cannot ask for a particular product to be booked out of stock, and a
+// stale copy of this file cannot send a part number that has since changed.
+//
+// It opens a review page rather than creating the order outright. Two reasons:
+// a link that creates records can be triggered by anything that can make a
+// browser fetch a URL, and a mistyped door should be read by someone before it
+// becomes a job on the floor.
+function sendToManufacturing(){
+  var base=odooBase();
+  if(!base){alert('Set your Odoo address first - the gear icon, under "Odoo Address".');try{openSettings();}catch(e){}return;}
+  // typeof, NOT a plain truth test: CD is an implicit global created by
+  // calculate(), so before the first door it is an undeclared name and
+  // touching it throws instead of being falsy.
+  if(typeof CD==='undefined'||!CD||!CD.vert||!CD.horiz){alert('Work out a door first.');return;}
+  var el=function(id){var n=document.getElementById(id);return n?(n.value||'').trim():'';};
+  var spec={
+    wo:el('wo'),mark:el('mark'),
+    width:CD.width,height:CD.height,
+    track:CD.tt,lift:CD.lt,hilift:CD.hl||0,
+    sections:CD.panels,
+    vertical:CD.vert,horizontal:CD.horiz,
+    weight:CD.hasWeight?CD.wt:null,
+    cable:CD.hasWeight?CD.cable:null,
+    cable_type:CD.hasWeight?(CD.cableType||''):'',
+    drum:CD.hasWeight?(CD.drum||''):''
+  };
+  if(!spec.wo&&!confirm('This door has no W/O number. Without one, sending twice will raise two orders. Send anyway?'))return;
+  window.open(base+'/door-work-order/new?spec='+encodeURIComponent(JSON.stringify(spec)),'_blank','noopener');
+}
