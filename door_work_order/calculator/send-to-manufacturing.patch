+// HOW MANY OF THIS DOOR. The quantity box has always been there and nothing
+// printed from it, so a sheet on the bench never said whether it was for one
+// door or five.
+function markQtyFor(label){
+  var out=0;
+  document.querySelectorAll('#op-list .op-mk').forEach(function(m){
+    var l=(m.querySelector('.op-lbl')||{value:''}).value||'';
+    if(l===label) out=parseInt((m.querySelector('.op-q')||{textContent:'1'}).textContent)||0;
+  });
+  return out;
+}
+function markQtyLabel(info){
+  info=info||{};
+  var q=parseInt(info.qty||0)||(info.mark?markQtyFor(info.mark):0);
+  var out='';
+  if(info.mark) out+=' &nbsp;|&nbsp; Mark '+info.mark;
+  if(q) out+=' &nbsp;|&nbsp; <strong style="color:#C0272D">'+q+' door'+(q>1?'s':'')+'</strong>';
+  return out;
+}
