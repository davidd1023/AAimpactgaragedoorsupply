+
+// EVERY MARK ON THE ORDER, EACH WITH ITS OWN NUMBERS.
+//
+// Each mark is opened in turn so that calculate() works it out properly -
+// reusing the one calculation rather than writing a second copy of the drum,
+// cable and bracket rules that would be free to drift from it.
+//
+// THE GUARD IS THE IMPORTANT PART. If a mark's form is incomplete, calculate()
+// returns early and CD still holds the PREVIOUS mark's numbers, so a careless
+// loop sends the same door several times under different letters. That is a
+// real failure and not a hypothetical one: buildAllSections() has it, which is
+// why "Print All Marks" today prints whichever mark is open once per chip. So
+// every mark is checked against what it was supposed to load, and one that
+// does not match is left out and named rather than sent wrong.
+function collectDoors(){
+  var chips=document.querySelectorAll('#op-list .op-mk');
+  var prev=opCur, doors=[], skipped=[];
+  Array.prototype.forEach.call(chips,function(m){
+    var mid=m.getAttribute('data-mid');
+    var label=((m.querySelector('.op-lbl')||{value:''}).value||'?');
+    var qty=parseInt((m.querySelector('.op-q')||{textContent:'1'}).textContent)||1;
+    var want=(typeof opData!=='undefined'&&opData[mid])?opData[mid]:{};
+    try{opOpenMark(mid,label);}catch(e){skipped.push(label);return;}
+    var d=doorSpecFromCD();
+    if(!d){skipped.push(label);return;}
+    // did the form really load THIS mark?
+    if(parseFloat(want.width)!==d.width||parseFloat(want.height)!==d.height){
+      skipped.push(label);return;
+    }
+    d.mark=label; d.qty=qty;
+    doors.push(d);
+  });
+  if(prev){
+    var back=document.querySelector('#op-list .op-mk[data-mid="'+prev+'"]');
+    if(back){try{opOpenMark(prev,(back.querySelector('.op-lbl')||{value:'?'}).value||'?');}catch(e){}}
+  }
+  return {doors:doors,skipped:skipped};
+}
