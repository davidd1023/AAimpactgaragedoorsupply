+// DID THE FORM REALLY LOAD THIS MARK? Every input calculate() can bail on is
+// checked, not just the two dimensions. It returns early for a hi-lift door
+// with an empty hi-lift box, for a low-headroom lift on a non-LHR track, and
+// for a blank track or lift - and in every one of those cases CD still holds
+// the PREVIOUS mark's results. Two marks of the same width and height, which
+// is the ordinary case on a multi-door job, slip through a width-and-height
+// check, and the mark goes out carrying the other one's track lengths, drum
+// and cable.
+//
+// ONE DEFINITION, used by both the sending loop and the printing loop. Two
+// copies of a six-way comparison is how one of them quietly stops matching.
+function markIsLoaded(want){
+  want=want||{};
+  if(typeof CD==='undefined'||!CD) return false;
+  var num=function(v){return parseFloat(v)||0;};
+  return num(want.width)===num(CD.width)
+      && num(want.height)===num(CD.height)
+      && (want.trackType||'')===(CD.tt||'')
+      && (want.liftType||'')===(CD.lt||'')
+      && num(want.highlift)===num(CD.hl)
+      && num(want.weight)===num(CD.hasWeight?CD.wt:0);
+}
+// Put the editor back on the mark that was open, or on the first one if that
+// mark is gone - opCur is null before anything is opened and stale after a
+// delete, which are exactly the cases a bare "restore if known" misses.
+function restoreMark(prev){
+  var back=prev?document.querySelector('#op-list .op-mk[data-mid="'+prev+'"]'):null;
+  if(!back) back=document.querySelector('#op-list .op-mk');
+  if(back){
+    try{opOpenMark(back.getAttribute('data-mid'),(back.querySelector('.op-lbl')||{value:'?'}).value||'?');}catch(e){}
+  }
+}
