<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- THE QUESTION GOES UNDER THE DELIVERY METHODS, where the customer has
       just said how the order is leaving - so "when will you collect it"
       follows "I am collecting it" rather than arriving out of nowhere.

       IT IS ALWAYS RENDERED, and hidden when the chosen method is not a
       collection. Odoo swaps delivery methods without reloading the page, so
       a block that only existed server-side when a pickup was already chosen
       would never appear for somebody who picks one after the page loads. -->

  <template id="checkout_pickup_slot" inherit_id="website_sale.checkout"
            name="Pickup day and time at checkout">

    <xpath expr="//t[@t-call='website_sale.delivery_form']" position="after">
      <t t-set="aa_pickup_methods"
         t-value="request.env['delivery.carrier'].sudo().search([('aa_is_pickup', '=', True)])"/>
      <t t-set="aa_days" t-value="order._aa_pickup_choices()"/>

      <div id="aa_pickup_slot"
           class="mt-4 d-none"
           t-att-data-pickup-ids="aa_pickup_methods.ids">
        <h5 class="mb-1">When will you collect it?</h5>

        <p class="text-muted small mb-3">
          We need two working days to make your order, so the earliest we can
          have it ready is
          <strong t-out="aa_days and aa_days[0][1] or ''"/>.
        </p>

        <div class="row g-2">
          <div class="col-12 col-md-7">
            <label class="form-label small" for="aa_pickup_day">Day</label>
            <select id="aa_pickup_day" name="aa_pickup_day" class="form-select">
              <option value="">Choose a day...</option>
              <t t-foreach="aa_days" t-as="aa_day">
                <option t-att-value="aa_day[0]"
                        t-att-selected="'selected' if order.aa_pickup_date == aa_day[0] else None"
                        t-out="aa_day[1]"/>
              </t>
            </select>
          </div>

          <div class="col-12 col-md-5">
            <label class="form-label small" for="aa_pickup_window">Time</label>
            <select id="aa_pickup_window" name="aa_pickup_window" class="form-select">
              <option value="">Choose a time...</option>
              <t t-foreach="order._aa_pickup_slot_choices()" t-as="aa_slot">
                <option t-att-value="aa_slot[0]"
                        t-att-selected="'selected' if order.aa_pickup_slot == aa_slot[0] else None"
                        t-out="aa_slot[1]"/>
              </t>
            </select>
          </div>
        </div>

        <div id="aa_pickup_warning"
             class="alert alert-warning py-2 px-3 small mt-3 d-none"
             role="alert"/>

        <p class="text-muted small mt-2 mb-0">
          Collect at <t t-out="order.company_id.name"/>,
          <t t-out="order.company_id.aa_pickup_hours or ''"/>.
        </p>
      </div>
    </xpath>

  </template>

</odoo>
