<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- IN MANUFACTURING > SETTINGS, where the rest of the shop floor is set
       up, rather than in Technical > Paper Formats. The owner changes label
       stock; nobody should have to know what a paper format is to do it.

       priority 40 so this applies after mrp's own settings view (35), whose
       Operations block it hangs off. -->
  <record id="res_config_settings_view_form_aa_sticker" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.aa.shop.floor</field>
    <field name="model">res.config.settings</field>
    <field name="priority" eval="40"/>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//block[@name='process_operations_setting_container']" position="after">
        <block title="Hardware Station" name="aa_hardware_station_container">
          <setting id="aa_sticker_size"
                   string="Hardware sticker"
                   help="What the hardware box's sticker is printed on. The label fits itself to the size, so a smaller sticker prints smaller type rather than running onto a second label.">
            <field name="aa_sticker_size"/>
            <div class="content-group mt-2" invisible="aa_sticker_size != 'custom'">
              <div class="row">
                <label for="aa_sticker_width_in" string="Width (inches)" class="col-lg-4 o_light_label"/>
                <field name="aa_sticker_width_in"/>
              </div>
              <div class="row">
                <label for="aa_sticker_height_in" string="Height (inches)" class="col-lg-4 o_light_label"/>
                <field name="aa_sticker_height_in"/>
              </div>
            </div>
          </setting>

          <!-- WHERE THE STICKER'S QR CODE POINTS, which is what three days
               of "the sticker leads to a not found page" turned out to be:
               web.base.url was the apex domain, which is not Odoo. Putting
               it here, with a button that reads the host out of the address
               bar, means nobody has to find Technical > System Parameters or
               type a hostname correctly. -->
          <setting id="aa_sticker_link_host"
                   string="Sticker QR links"
                   help="The site a scanned sticker opens. It must be the address you reach Odoo on, or every sticker printed points somewhere that cannot serve it - which cannot be seen by looking at a QR code.">
            <div class="text-muted">
              Stickers are printed pointing at
              <b><field name="aa_sticker_link_host" class="oe_inline" readonly="1"/></b>
            </div>

            <div class="alert alert-warning mt-2 mb-0" role="alert"
                 invisible="not aa_sticker_link_wrong">
              That is not the address you are reading this on
              (<b><field name="aa_sticker_link_here" class="oe_inline" readonly="1"/></b>),
              so stickers are being printed with a link that will not open.
            </div>

            <div class="alert alert-warning mt-2 mb-0" role="alert"
                 invisible="aa_sticker_link_frozen">
              This host is <b>not frozen</b>, so Odoo will change it to
              whichever site an administrator next signs in from - and every
              sticker printed after that points at the wrong place.
            </div>

            <div class="mt-2">
              <button type="object"
                      name="action_aa_sticker_use_this_site"
                      string="Use this site for sticker links"
                      class="btn btn-primary"/>
              <div class="text-muted small mt-1">
                Sets the link host to the address in your browser and freezes
                it. Stickers already printed keep the old link until they are
                printed again.
              </div>
            </div>
          </setting>
        </block>
      </xpath>
    </field>
  </record>

</odoo>
