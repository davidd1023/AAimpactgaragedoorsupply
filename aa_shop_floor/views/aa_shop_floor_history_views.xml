<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Shop Floor History (owner, 2026-10-15): every job of every order, who
         did it, when it started, when it was marked done and how long it took.
         Read from Odoo's own work order time log. -->
    <record id="aa_shop_floor_history_list" model="ir.ui.view">
        <field name="name">mrp.workorder.list.aa.shop.floor.history</field>
        <field name="model">mrp.workorder</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Shop Floor History" create="0" edit="0" delete="0" default_order="date_start desc">
                <field name="aa_wo_number"/>
                <field name="aa_sale_order" optional="hide"/>
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="workcenter_id" string="Station"/>
                <field name="name" string="Task" optional="hide"/>
                <field name="employee_ids" string="Worker" widget="many2many_tags"/>
                <field name="date_start" string="Started"/>
                <field name="date_finished" string="Finished"/>
                <field name="duration" string="Time (min:sec)" widget="float_time" sum="Total"/>
                <field name="duration_expected" string="Expected (min:sec)" widget="float_time" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'" decoration-info="state == 'progress'"/>
            </list>
        </field>
    </record>

    <record id="aa_shop_floor_history_search" model="ir.ui.view">
        <field name="name">mrp.workorder.search.aa.shop.floor.history</field>
        <field name="model">mrp.workorder</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search string="Shop Floor History">
                <field name="aa_wo_number"/>
                <field name="aa_sale_order"/>
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="workcenter_id" string="Station"/>
                <field name="employee_ids" string="Worker"/>
                <filter name="aa_done" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="aa_progress" string="In Progress" domain="[('state', '=', 'progress')]"/>
                <separator/>
                <filter name="aa_finished" string="Finished" date="date_finished"/>
                <group>
                    <filter name="aa_by_wo" string="W/O #" context="{'group_by': 'aa_wo_number'}"/>
                    <filter name="aa_by_order" string="Sale Order" context="{'group_by': 'aa_sale_order'}"/>
                    <filter name="aa_by_station" string="Station" context="{'group_by': 'workcenter_id'}"/>
                    <filter name="aa_by_day" string="Day Finished" context="{'group_by': 'date_finished:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="aa_shop_floor_history_action" model="ir.actions.act_window">
        <field name="name">Shop Floor History</field>
        <field name="res_model">mrp.workorder</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="aa_shop_floor_history_list"/>
        <field name="search_view_id" ref="aa_shop_floor_history_search"/>
        <field name="domain">[('state', 'in', ('progress', 'done'))]</field>
        <field name="context">{'search_default_aa_by_wo': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No jobs started yet</p>
            <p>Every job started at a Shop Floor station shows here, with its time.</p>
        </field>
    </record>

    <menuitem id="aa_shop_floor_history_menu"
              name="Shop Floor History"
              parent="mrp.menu_mrp_reporting"
              action="aa_shop_floor_history_action"
              sequence="5"/>
</odoo>
