<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_aa_shop_floor" model="ir.ui.view">
        <field name="name">mrp.production.form.aa.shop.floor</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Shop Floor" name="aa_shop_floor" invisible="not aa_shop_spec">
                    <group>
                        <field name="aa_sale_line_id" readonly="1"/>
                        <field name="aa_shop_spec" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- The order's transfer shows where each part (Tracks / Springs / Hardware)
         is in the Shop Floor, under Destination Location. -->
    <record id="view_picking_form_aa_order_status" model="ir.ui.view">
        <field name="name">stock.picking.form.aa.order.status</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_dest_id']" position="after">
                <field name="aa_order_status" invisible="not aa_order_status" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
