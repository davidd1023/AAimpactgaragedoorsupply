<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_aa_shop_floor" model="ir.ui.view">
        <field name="name">mrp.production.form.aa.shop.floor</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Shop Floor" name="aa_shop_floor" invisible="not aa_shop_spec">
                    <group>
                        <field name="aa_sale_line_id" readonly="1"/>
                        <field name="aa_shop_spec" readonly="1"/>
                        <!-- THE STICKER'S LINK, WHERE SOMEBODY CAN SEE IT.
                             Owner, 2026-10-28: "i still get the not found
                             page when scanning the sticker on my phone" -
                             and there was no way to read the link except by
                             pointing a camera at it, so nobody could tell a
                             bad token from a bad host from a bad camera.
                             Clicking it here opens exactly what the QR code
                             holds, from a browser already signed in. -->
                        <field name="aa_box_url" widget="url" readonly="1"
                               invisible="aa_station_kind != 'kit'"
                               string="Box sticker link"/>

                        <!-- AND WHICH HOST IT POINTS AT, because that was the
                             fault: his Prod printed every sticker pointing at
                             the apex domain, which is not Odoo and does not
                             redirect to the www that is (owner, 2026-10-28,
                             with the scanned link at last). A QR code cannot
                             be proof-read, so the host has to be legible
                             somewhere a person can look. -->
                        <field name="aa_box_url_warning" readonly="1"
                               invisible="aa_station_kind != 'kit'"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- The order's transfer shows where each part (Tracks / Springs / Hardware)
         is in the Shop Floor, under Destination Location. -->
    <record id="view_picking_form_aa_order_status" model="ir.ui.view">
        <field name="name">stock.picking.form.aa.order.status</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_dest_id'][contains(@options, 'no_create')]" position="after">
                <field name="aa_order_status" invisible="not aa_order_status" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
