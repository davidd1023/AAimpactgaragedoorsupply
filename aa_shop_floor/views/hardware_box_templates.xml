<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- WHAT THE PHONE SEES.

       A whole document rather than a website page, for the same reasons the
       bench kiosks are: this is read once, in a garage or on a ladder, by
       somebody who scanned a box. No menu, no cart, no search, nothing to tap
       by accident - and everything inline, so a page that has to be read at
       the kerb is not waiting on an asset bundle first.

       BIG AND HIGH CONTRAST. It is read at arm's length, often in sunlight. -->
  <template id="hardware_box_page" name="Hardware box">&lt;!DOCTYPE html&gt;
<html>
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title><t t-esc="card['order']"/> - Hardware</title>
    <style>
      * { box-sizing: border-box; }
      body { margin: 0; font-family: Arial, Helvetica, sans-serif;
             color: #111; background: #f4f5f7; font-size: 17px; }
      header { background: #1f2d3d; color: #fff; padding: 18px; }
      header .order { font-size: 26px; font-weight: bold; }
      header .door { font-size: 18px; opacity: .9; margin-top: 2px; }
      header .kit { font-size: 16px; opacity: .75; margin-top: 6px; }
      main { padding: 14px; max-width: 620px; margin: 0 auto; }
      .door_size { background: #fff; border: 1px solid #d6dbe1;
                   border-radius: 10px; padding: 14px; margin-bottom: 12px;
                   display: flex; justify-content: space-between;
                   align-items: baseline; gap: 12px; }
      .door_size .size { font-size: 24px; font-weight: bold; }
      .door_size .weight { font-size: 20px; color: #1f2d3d; }
      table { width: 100%; border-collapse: collapse; background: #fff;
              border: 1px solid #d6dbe1; border-radius: 10px; }
      th { text-align: left; color: #5a6b7c; font-size: 14px;
           text-transform: uppercase; letter-spacing: .04em;
           font-weight: bold; padding: 12px 14px 12px 14px;
           width: 38%; vertical-align: top; }
      td { padding: 12px 14px 12px 0; font-size: 19px; font-weight: bold;
           vertical-align: top; }
      tr + tr th, tr + tr td { border-top: 1px solid #e6e9ed; }
      .aa_green { color: #156c2e; }
      .aa_red { color: #a4262c; }
      .aa_ok { background: #e8f5ec; border: 1px solid #9bd3ad; color: #10401f;
               border-radius: 10px; padding: 12px 14px; margin: 10px 0;
               font-weight: bold; }
      .aa_bad { background: #fdeaea; border: 1px solid #e5a3a5; color: #7a1d20;
                border-radius: 10px; padding: 12px 14px; margin: 10px 0;
                font-weight: bold; }
      .aa_btn { display: block; width: 100%; margin-top: 14px; padding: 16px;
                font-size: 20px; font-weight: bold; color: #fff;
                background: #156c2e; border: 0; border-radius: 10px; }
      .aa_signin_wrap { margin-top: 22px; text-align: center; }
      .aa_signin { display: inline-block; padding: 10px 16px; font-size: 14px;
                   color: #714B67; text-decoration: none;
                   border: 1px solid #d6dbe1; border-radius: 8px;
                   background: #fff; }
      .aa_btn_dead { background: #9aa4ae; }
      .section { margin: 22px 0 8px; font-size: 14px; color: #5a6b7c;
                 text-transform: uppercase; letter-spacing: .04em; }
      footer { color: #5a6b7c; font-size: 14px; padding: 18px;
               text-align: center; }
    </style>
  </head>
  <body>
    <header>
      <div class="order"><t t-esc="card['order']"/></div>
      <div class="door" t-if="card.get('door')"><t t-esc="card['door']"/></div>
      <div class="kit" t-if="card.get('kit')">
        <t t-esc="card['kit']"/> hardware
      </div>
    </header>

    <main>
      <div class="door_size" t-if="card.get('size') or card.get('weight')">
        <span class="size"><t t-esc="card.get('size')"/></span>
        <span class="weight"><t t-esc="card.get('weight')"/></span>
      </div>

      <table t-if="card['rows']">
        <t t-foreach="card['rows']" t-as="row" t-key="row_index">
          <tr>
            <th><t t-esc="row[0]"/></th>
            <td><t t-esc="row[1]"/></td>
          </tr>
        </t>
      </table>

      <!-- Anything on the order that belongs to no door. Shown, because a
           spring that is on the order and on no box is exactly the thing
           somebody needs to be told about. -->
      <t t-if="card.get('also')">
        <div class="section">Also on this order</div>
        <table>
          <t t-foreach="card['also']" t-as="row" t-key="row_index">
            <tr>
              <th><t t-esc="row[0]"/></th>
              <td><t t-esc="row[1]"/></td>
            </tr>
          </t>
        </table>
      </t>
      <!-- THE DISPATCH PANEL (owner, 2026-10-28: "actually the qr code is
           supposed to be on the sticker"). Drawn only for somebody signed in
           on the dispatch desk - a fitter on a ladder, a driver or the
           customer scanning the same code sees the door's figures above and
           nothing of this. -->
      <t t-if="dispatch">
        <div class="section">Dispatch</div>

        <div t-if="notice" class="aa_ok"><t t-esc="notice"/></div>
        <div t-if="problem" class="aa_bad"><t t-esc="problem"/></div>

        <table>
          <tr>
            <th>Payment</th>
            <td t-attf-class="#{'aa_green' if dispatch['paid'] else 'aa_red'}">
              <t t-esc="dispatch['payment']"/>
            </td>
          </tr>
          <tr>
            <th>Stations</th>
            <td t-attf-class="#{'aa_green' if dispatch['finished'] else 'aa_red'}">
              <t t-if="dispatch['finished']">All finished</t>
              <t t-else="">
                Still open:
                <t t-esc="', '.join(dispatch['open_jobs'])"/>
              </t>
            </td>
          </tr>
          <tr>
            <th>Delivery</th>
            <td><t t-esc="dispatch['picking'].name"/></td>
          </tr>
        </table>

        <t t-if="dispatch['already']">
          <div class="aa_ok">
            Dispatched by <t t-esc="dispatch['picking'].aa_dispatched_by.name"/>.
          </div>
        </t>
        <t t-elif="not dispatch['paid']">
          <button class="aa_btn aa_btn_dead" disabled="disabled">
            Cannot dispatch - not paid
          </button>
        </t>
        <t t-elif="not dispatch['ready']">
          <button class="aa_btn aa_btn_dead" disabled="disabled">
            Not ready to go out
          </button>
        </t>
        <t t-else="">
          <form method="post"
                t-attf-action="/box/#{production.id}/#{token}/dispatch">
            <input type="hidden" name="csrf_token"
                   t-att-value="request.csrf_token()"/>
            <button type="submit" class="aa_btn"
                    t-att-onclick="'return confirm(&quot;A station is still open. Dispatch anyway?&quot;);' if dispatch['needs_confirm'] else None">
              Mark Dispatched
            </button>
          </form>
        </t>
      </t>

      <!-- THE DESK, WITH NOTHING TO DISPATCH. Drawing nothing at all was
           the fault: on a two-step warehouse the outgoing delivery does not
           exist until the internal pick is validated, so a packed box
           scanned by the right person showed no Dispatch section and no
           reason for it. -->
      <t t-if="dispatch_none">
        <div class="section">Dispatch</div>
        <div class="aa_bad"><t t-esc="dispatch_none"/></div>
      </t>

      <!-- AND FOR A PHONE THAT IS NOT SIGNED IN. The team scans with
           "a phone or tablet" (owner, 2026-10-28): a shared tablet signs in
           once and keeps the Dispatch panel above, but a phone out of
           somebody's pocket never has, and drew the figures with no sign
           that dispatch existed at all. One line, and signing in comes back
           to this sticker.

           Shown to the PUBLIC only - a dealer or a fitter already signed in
           would not get the panel by signing in again. -->
      <div t-if="dispatch_sign_in" class="aa_signin_wrap">
        <a class="aa_signin" t-att-href="dispatch_sign_in">
          Staff: sign in to dispatch this order
        </a>
      </div>
    </main>

    <footer>
      <t t-esc="company.name"/>
    </footer>
  </body>
</html>
  </template>


  <!-- WHY A STICKER WOULD NOT OPEN, for somebody who works here.
       Owner, 2026-10-28: "when i try scanning the qr code on the sticker it
       leads to a not found page" - and the page would not say which of four
       reasons it was. A stranger still gets the bare 404. -->
  <template id="hardware_box_refused" name="Hardware box - cannot open">&lt;!DOCTYPE html&gt;
<html>
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>Sticker will not open</title>
    <style>
      body { margin: 0; font-family: Arial, Helvetica, sans-serif;
             background: #f4f5f7; color: #111; font-size: 17px; }
      main { padding: 24px 16px; max-width: 620px; margin: 0 auto; }
      h1 { font-size: 22px; margin: 0 0 14px; }
      .why { background: #fff; border: 1px solid #d6dbe1; border-radius: 10px;
             padding: 16px; line-height: 1.5; }
      a.signin { display: block; margin-top: 18px; padding: 14px 16px;
                 background: #714B67; color: #fff; text-decoration: none;
                 border-radius: 10px; text-align: center; font-weight: bold; }
      p.note { color: #555; font-size: 15px; line-height: 1.5; }
    </style>
  </head>
  <body>
    <main>
      <h1>This sticker will not open</h1>

      <!-- STAFF GET THE REASON, which is one of four and names the fault. -->
      <div t-if="why" class="why"><t t-esc="why"/></div>

      <!-- A PHONE AT THE COUNTER IS NOT SIGNED IN, so this is what the man
           holding the box actually sees. It says nothing about why - the page
           is identical for all four reasons - but it is one tap to finding
           out, which a bare 404 never was. -->
      <t t-if="sign_in">
        <p class="note">
          If you work here, sign in and this page will say why.
        </p>
        <a class="signin" t-att-href="sign_in">Sign in and try again</a>
      </t>
    </main>
  </body>
</html>
  </template>

</odoo>
