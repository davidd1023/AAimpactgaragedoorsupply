<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- READ STANDING UP, at a bench, so the values are big and the labels
         are not. Same rows, same order and same words as the sticker and the
         page the sticker opens: all three read one card. -->
    <t t-name="aa_shop_floor.HardwareCardDialog">
        <Dialog title="title" size="'md'">
            <div t-if="props.card.kit" class="text-muted text-uppercase small mb-2">
                <t t-esc="props.card.kit"/> hardware
                <span t-if="props.card.customer"> · <t t-esc="props.card.customer"/></span>
            </div>

            <div t-if="props.card.size or props.card.weight"
                 class="d-flex justify-content-between align-items-baseline gap-3 border-top border-bottom py-2 mb-2">
                <span class="fs-4 fw-bold" t-esc="props.card.size"/>
                <span class="fs-5" t-esc="props.card.weight"/>
            </div>

            <table class="table table-sm mb-0 align-top">
                <tbody>
                    <tr t-foreach="props.card.rows" t-as="aaRow" t-key="aaRow_index">
                        <th class="text-muted text-uppercase fw-normal small" style="width: 38%" t-esc="aaRow[0]"/>
                        <td class="fw-bold fs-5" t-esc="aaRow[1]"/>
                    </tr>
                </tbody>
            </table>

            <t t-if="props.card.also and props.card.also.length">
                <div class="text-muted text-uppercase small border-top pt-2 mt-2">
                    Also on this order
                </div>
                <table class="table table-sm mb-0 align-top">
                    <tbody>
                        <tr t-foreach="props.card.also" t-as="aaRow" t-key="aaRow_index">
                            <th class="text-muted text-uppercase fw-normal small" style="width: 38%" t-esc="aaRow[0]"/>
                            <td class="fw-bold" t-esc="aaRow[1]"/>
                        </tr>
                    </tbody>
                </table>
            </t>

            <t t-set-slot="footer">
                <button type="button" class="btn btn-primary" t-on-click="printSticker">
                    <i class="fa fa-print me-1"/>Print sticker
                </button>
                <!-- WHAT IT PRINTS ON, next to the button that prints it
                     (owner, 2026-10-19). The same setting as Manufacturing >
                     Settings, changed from where the printer is: pick the
                     roll that is in the machine, then print. -->
                <select class="form-select w-auto o_aa_sticker_size"
                        aria-label="Sticker size"
                        t-on-change="onChangeSize">
                    <option t-foreach="sizes.options" t-as="aaSize" t-key="aaSize[0]"
                            t-att-value="aaSize[0]"
                            t-att-selected="aaSize[0] === sizes.current ? 'selected' : false"
                            t-esc="aaSize[1]"/>
                </select>
                <button type="button" class="btn btn-secondary" t-on-click="() => this.props.close()">
                    Close
                </button>
            </t>
        </Dialog>
    </t>

</templates>
