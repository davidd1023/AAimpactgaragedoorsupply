<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mrp_workorder.MrpDisplayRecord" t-inherit-mode="extension">
        <xpath expr="//span[@class='o_finished_product mt-auto mb-0']" position="after">
            <div t-if="record.aa_shop_spec" class="o_aa_shop_spec border rounded p-2 bg-100">
                <t t-set="aaRows" t-value="record.aa_shop_spec.split('\n')"/>
                <!-- Overview shows only the summary; the full list is at the station. -->
                <t t-set="aaLimit" t-value="aaSpecLimit(aaRows)"/>
                <t t-foreach="aaRows.slice(0, aaLimit)" t-as="aaRow" t-key="aaRow_index">
                    <t t-set="aaParts" t-value="aaRow.split('|')"/>
                    <div t-if="!aaParts[1] and aaParts[2] === 'c'"
                         class="o_aa_shop_spec_section o_aa_check d-flex align-items-center gap-2 fw-bold text-uppercase border-top mt-2 pt-1 cursor-pointer"
                         t-att-class="{'o_aa_packed': aaIsPacked(aaRow_index)}"
                         t-on-click.stop="() => this.aaTogglePacked(aaRow_index)">
                        <i class="fa fa-fw" t-att-class="aaIsPacked(aaRow_index) ? 'fa-check-square text-success' : 'fa-square-o text-muted'"/>
                        <span class="o_aa_label flex-grow-1" t-esc="aaParts[0]"/>
                    </div>
                    <div t-elif="!aaParts[1]" class="o_aa_shop_spec_section d-flex justify-content-between fw-bold text-uppercase border-top mt-2 pt-1">
                        <span t-esc="aaParts[0]"/>
                        <span t-if="aaParts[0] === 'Box contents' or aaParts[0] === 'Parts'" class="text-muted" t-esc="aaPackedCount(aaRows)"/>
                    </div>
                    <div t-elif="aaParts[2] === 'c'"
                         class="o_aa_check d-flex align-items-center gap-2 cursor-pointer"
                         t-att-class="{'o_aa_packed': aaIsPacked(aaRow_index)}"
                         t-on-click.stop="() => this.aaTogglePacked(aaRow_index)">
                        <i class="fa fa-fw" t-att-class="aaIsPacked(aaRow_index) ? 'fa-check-square text-success' : 'fa-square-o text-muted'"/>
                        <span class="o_aa_label flex-grow-1" t-esc="aaParts[0]"/>
                        <span class="fw-bold text-end" t-esc="aaParts[1]"/>
                    </div>
                    <div t-else="" class="d-flex justify-content-between gap-3">
                        <span class="text-muted" t-esc="aaParts[0]"/>
                        <span class="fw-bold text-end" t-esc="aaParts[1]"/>
                    </div>
                </t>
                <div t-if="aaLimit &lt; aaRows.length" class="o_aa_spec_more d-flex justify-content-between text-muted border-top mt-2 pt-1">
                    <span t-esc="aaSpecSummary(aaRows, aaLimit)"/>
                    <span t-esc="aaPackedCount(aaRows)"/>
                </div>
            </div>
            <t t-if="record.aa_station_board">
                <t t-set="aaBoardData" t-value="aaBoard()"/>
                <div t-if="aaBoardData.received" class="o_aa_received text-muted small mt-1">
                    <i class="fa fa-clock-o me-1"/>Received <t t-esc="aaBoardData.received"/>
                </div>
                <div t-if="aaBoardData.can_assign and (aaBoardData.can_send or aaBoardData.can_remove)"
                     class="o_aa_assign d-flex flex-wrap align-items-center gap-2 mt-2">
                    <span t-if="aaBoardData.can_send" class="badge text-bg-warning">Pending</span>
                    <button t-if="aaBoardData.can_send" type="button" class="btn btn-primary"
                            t-on-click.stop="() => this.aaRelease('aa_send_to_station')">
                        <i class="fa fa-arrow-right me-1"/>Send to <t t-esc="aaBoardData.station"/>
                    </button>
                    <button t-if="aaBoardData.can_remove" type="button" class="btn btn-outline-secondary"
                            t-on-click.stop="() => this.aaRelease('aa_remove_from_station')">
                        <i class="fa fa-undo me-1"/>Remove from <t t-esc="aaBoardData.station"/>
                    </button>
                </div>
            </t>
        </xpath>
    </t>
</templates>
