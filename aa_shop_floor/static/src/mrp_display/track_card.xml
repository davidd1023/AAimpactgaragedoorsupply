<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Called from MrpDisplayRecord with aaTracks set (track_card.js). -->
    <t t-name="aa_shop_floor.TrackCards">
        <div t-foreach="aaTracks" t-as="aaTrack" t-key="aaTrack.key" class="o_aa_track_card border rounded p-2 mt-2 bg-100">
            <t t-set="aaCard" t-value="aaTrack.card"/>
            <div class="d-flex justify-content-between align-items-center gap-2">
                <span class="fs-3 fw-bold text-uppercase" t-esc="aaT(aaCard.kind === 'vertical' ? 'Vertical' : 'Horizontal')"/>
                <span t-if="aaCard.lift" class="badge fs-6 text-wrap"
                      t-att-class="aaCard.lift === 'Standard' ? 'text-bg-secondary' : 'text-bg-danger'">
                    <t t-esc="aaT('Lift')"/>: <t t-esc="aaT(aaCard.lift)"/>
                </span>
            </div>
            <div class="text-muted">
                <t t-esc="aaCard.track"/><t t-if="aaCard.door"> · <t t-esc="aaT('Door height')"/> <t t-esc="aaCard.door"/></t>
            </div>

            <!-- WHAT TO TAKE, and Change right beside it. -->
            <div class="d-flex justify-content-between align-items-center gap-2 mt-2">
                <div>
                    <div class="text-muted small text-uppercase" t-esc="aaT('Take')"/>
                    <t t-if="aaCard.take">
                        <div class="fs-4 fw-bold">
                            <t t-esc="aaCard.take_length or aaCard.take"/> RAW × <t t-esc="aaCard.take_qty"/> <span class="fs-6 fw-normal" t-esc="aaT('pairs')"/>
                        </div>
                        <div class="small" t-att-class="aaCard.short ? 'text-danger fw-bold' : 'text-muted'">
                            <t t-esc="aaT('On hand')"/>: <t t-esc="aaCard.on_hand"/>
                            <t t-if="aaCard.short"> - <t t-esc="aaT('not enough, change it')"/></t>
                        </div>
                    </t>
                    <div t-else="" class="fs-5 fw-bold text-danger" t-esc="aaT('Choose the RAW track')"/>
                </div>
                <button t-if="aaTrackOpen()" type="button" class="btn btn-lg btn-outline-primary text-nowrap"
                        t-on-click.stop="() => this.aaChangeTrack(aaTrack.productionId)">
                    <i class="fa fa-exchange me-1"/><t t-esc="aaT('Change')"/>
                </button>
            </div>

            <!-- WHAT TO CUT IT TO: the biggest thing on the card. -->
            <div class="d-flex justify-content-between align-items-center rounded p-2 mt-2"
                 t-att-class="aaCard.cut ? 'bg-warning-subtle' : 'bg-success-subtle'">
                <span class="fw-bold text-uppercase" t-esc="aaT(aaCard.cut ? 'Cut to' : 'No cut')"/>
                <span class="fs-2 fw-bold" t-esc="aaCard.length"/>
            </div>
            <div class="d-flex justify-content-between mt-1">
                <span class="text-muted" t-esc="aaT('Pairs')"/>
                <span class="fw-bold"><t t-esc="aaCard.pairs"/> (LH + RH)</span>
            </div>

            <div t-if="aaCard.jambs and aaCard.jambs.length" class="mt-2 border-top pt-1">
                <div class="text-muted small text-uppercase" t-esc="aaT('Jamb brackets per vertical')"/>
                <div class="d-flex flex-wrap gap-3 fs-5">
                    <span t-foreach="aaCard.jambs" t-as="aaJamb" t-key="aaJamb_index">
                        <span class="fw-bold" t-esc="aaJamb.name"/> × <t t-esc="aaJamb.per"/>
                    </span>
                </div>
            </div>
            <div t-foreach="aaCard.prep or []" t-as="aaPrep" t-key="aaPrep_index" class="mt-1 fw-bold text-danger" t-esc="aaPrep"/>
        </div>
    </t>
</templates>
