<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Update the default warehouse with the company name -->
        <record id="stock.warehouse0" model="stock.warehouse">
            <field name="name">AA Impact Main Warehouse</field>
            <field name="code">AAIG</field>
        </record>

        <!-- Enable dropship route on the warehouse -->
        <function model="stock.warehouse" name="write">
            <value eval="[ref('stock.warehouse0')]"/>
            <value eval="{'delivery_steps': 'pick_ship'}"/>
        </function>

    </data>
</odoo>
