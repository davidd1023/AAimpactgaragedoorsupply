<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================
             VENDORS
        ============================================================ -->

        <!-- Manufacturer: AA Impact Garage Door -->
        <record id="partner_aa_impact_mfg" model="res.partner">
            <field name="name">AA Impact Garage Door</field>
            <field name="is_company" eval="True"/>
            <field name="supplier_rank">1</field>
            <field name="customer_rank">0</field>
            <field name="country_id" ref="base.us"/>
            <field name="comment">Primary door manufacturer — dispatch/dropship partner</field>
        </record>

        <!-- Supplier: Iowa Spring -->
        <record id="partner_iowa_spring" model="res.partner">
            <field name="name">Iowa Spring</field>
            <field name="is_company" eval="True"/>
            <field name="supplier_rank">1</field>
            <field name="customer_rank">0</field>
            <field name="country_id" ref="base.us"/>
            <field name="comment">Spring supplier — torsion and extension springs</field>
        </record>

        <!-- Supplier: CHI Hardware -->
        <record id="partner_chi_hardware" model="res.partner">
            <field name="name">CHI Hardware</field>
            <field name="is_company" eval="True"/>
            <field name="supplier_rank">1</field>
            <field name="customer_rank">0</field>
            <field name="country_id" ref="base.us"/>
            <field name="comment">Hardware supplier — hinges and hardware components</field>
        </record>

        <!-- ============================================================
             TAXES
        ============================================================ -->

        <!-- Florida 7% Sales Tax -->
        <record id="tax_fl_7" model="account.tax">
            <field name="name">Florida Sales Tax 7%</field>
            <field name="type_tax_use">sale</field>
            <field name="amount_type">percent</field>
            <field name="amount">7.0</field>
            <field name="description">7% FL</field>
        </record>

        <!-- Tax Exempt for resale customers -->
        <record id="tax_exempt_resale" model="account.tax">
            <field name="name">Tax Exempt (Resale)</field>
            <field name="type_tax_use">sale</field>
            <field name="amount_type">percent</field>
            <field name="amount">0.0</field>
            <field name="description">Exempt</field>
        </record>

        <!-- ============================================================
             FISCAL POSITION — Tax-Exempt B2B customers
        ============================================================ -->
        <record id="fiscal_position_exempt" model="account.fiscal.position">
            <field name="name">Tax Exempt (Resale Certificate)</field>
            <field name="note">For B2B customers with a valid Florida resale certificate.</field>
            <field name="tax_ids" eval="[(4, ref('tax_exempt_resale'))]"/>
        </record>

    </data>
</odoo>
