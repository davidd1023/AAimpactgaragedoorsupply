<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- ── Homepage Hero + Featured Kits ───────────────────────────────── -->
    <template id="aa_impact_homepage" name="AA Impact Homepage"
              inherit_id="website.homepage" active="True">
      <xpath expr="//div[@id='wrap']" position="replace">
        <div id="wrap">

          <!-- ── HERO ──────────────────────────────────────────────────── -->
          <section style="background: linear-gradient(135deg, #0d2764 0%, #1a3d8f 60%, #0a1e4f 100%); padding: 80px 0; position: relative; overflow: hidden;">
            <!-- Background pattern -->
            <div style="position:absolute;top:0;left:0;right:0;bottom:0;opacity:0.05;background-image:repeating-linear-gradient(45deg,#fff 0,#fff 1px,transparent 0,transparent 50%);background-size:20px 20px;"></div>
            <div class="container" style="position:relative;z-index:1;">
              <div class="row align-items-center">
                <div class="col-lg-6 text-white">
                  <p style="color:#f0c040;font-weight:700;font-size:14px;letter-spacing:3px;text-transform:uppercase;margin-bottom:12px;">South Florida's Garage Door Supply</p>
                  <h1 style="font-size:48px;font-weight:800;line-height:1.1;margin-bottom:20px;color:#fff;">
                    Everything You Need<br/>
                    <span style="color:#f0c040;">To Build It Right</span>
                  </h1>
                  <p style="font-size:18px;color:rgba(255,255,255,0.85);margin-bottom:32px;line-height:1.6;">
                    Complete hardware kits, tracks, hinges, rollers and more —
                    for the 1200, 1600 &amp; 1800 series. In stock. Ready for pickup.
                  </p>
                  <div class="d-flex flex-wrap gap-3">
                    <a href="/shop?categ=Hardware Kits"
                       style="background:#f0c040;color:#0d2764;padding:16px 36px;border-radius:4px;font-weight:700;font-size:16px;text-decoration:none;display:inline-block;">
                      Shop Hardware Kits
                    </a>
                    <a href="/shop"
                       style="background:transparent;color:#fff;border:2px solid rgba(255,255,255,0.5);padding:14px 32px;border-radius:4px;font-weight:600;font-size:16px;text-decoration:none;display:inline-block;">
                      Browse All Products
                    </a>
                  </div>
                </div>
                <div class="col-lg-6 text-center mt-5 mt-lg-0">
                  <img src="https://duralifthardware.com/cdn/shop/products/box1.jpg?v=1595343893"
                       alt="Hardware Kit"
                       style="max-width:420px;width:100%;border-radius:12px;box-shadow:0 30px 60px rgba(0,0,0,0.4);"/>
                </div>
              </div>
            </div>
          </section>

          <!-- ── VALUE PROPS STRIP ──────────────────────────────────────── -->
          <section style="background:#32373c;padding:20px 0;">
            <div class="container">
              <div class="row text-center text-white">
                <div class="col-6 col-md-3" style="padding:12px;">
                  <span style="font-size:22px;">📦</span>
                  <p style="margin:4px 0 0;font-size:14px;font-weight:600;">Ready-to-Assemble Kits</p>
                </div>
                <div class="col-6 col-md-3" style="padding:12px;">
                  <span style="font-size:22px;">🏪</span>
                  <p style="margin:4px 0 0;font-size:14px;font-weight:600;">Local Pickup — Medley, FL</p>
                </div>
                <div class="col-6 col-md-3" style="padding:12px;">
                  <span style="font-size:22px;">🔧</span>
                  <p style="margin:4px 0 0;font-size:14px;font-weight:600;">1200 · 1600 · 1800 Series</p>
                </div>
                <div class="col-6 col-md-3" style="padding:12px;">
                  <span style="font-size:22px;">📞</span>
                  <p style="margin:4px 0 0;font-size:14px;font-weight:600;">786-238-7640</p>
                </div>
              </div>
            </div>
          </section>

          <!-- ── HARDWARE KITS SECTION ──────────────────────────────────── -->
          <section style="padding:70px 0;background:#f8f9fa;">
            <div class="container">
              <div class="text-center mb-5">
                <h2 style="font-size:36px;font-weight:800;color:#0d2764;">Hardware Kits</h2>
                <p style="color:#666;font-size:18px;max-width:600px;margin:12px auto 0;">
                  Pre-specified kits for 4–7 panel doors across all three series.
                  Everything in one box — hinges, rollers, drums, cables and more.
                </p>
              </div>

              <!-- Series tabs -->
              <div class="row g-4 justify-content-center">
                <div class="col-12 col-md-4">
                  <div style="background:#fff;border-radius:12px;padding:32px;text-align:center;box-shadow:0 4px 20px rgba(0,0,0,0.08);border-top:4px solid #0d2764;">
                    <h3 style="color:#0d2764;font-weight:700;font-size:24px;margin-bottom:8px;">1200 Series</h3>
                    <p style="color:#666;margin-bottom:20px;">Standard residential · 4–7 panels</p>
                    <p style="font-size:28px;font-weight:800;color:#0d2764;">From $402</p>
                    <a href="/shop?search=HK-1200"
                       style="display:block;background:#0d2764;color:#fff;padding:12px;border-radius:4px;text-decoration:none;font-weight:600;margin-top:16px;">
                      Shop 1200 Kits →
                    </a>
                  </div>
                </div>
                <div class="col-12 col-md-4">
                  <div style="background:#0d2764;border-radius:12px;padding:32px;text-align:center;box-shadow:0 8px 32px rgba(13,39,100,0.35);transform:scale(1.03);">
                    <span style="background:#f0c040;color:#0d2764;font-size:11px;font-weight:700;padding:4px 12px;border-radius:20px;letter-spacing:1px;text-transform:uppercase;">Most Popular</span>
                    <h3 style="color:#fff;font-weight:700;font-size:24px;margin:12px 0 8px;">1600 Series</h3>
                    <p style="color:rgba(255,255,255,0.75);margin-bottom:20px;">Standard · 4–7 panels</p>
                    <p style="font-size:28px;font-weight:800;color:#f0c040;">From $411</p>
                    <a href="/shop?search=HK-1600"
                       style="display:block;background:#f0c040;color:#0d2764;padding:12px;border-radius:4px;text-decoration:none;font-weight:700;margin-top:16px;">
                      Shop 1600 Kits →
                    </a>
                  </div>
                </div>
                <div class="col-12 col-md-4">
                  <div style="background:#fff;border-radius:12px;padding:32px;text-align:center;box-shadow:0 4px 20px rgba(0,0,0,0.08);border-top:4px solid #0d2764;">
                    <h3 style="color:#0d2764;font-weight:700;font-size:24px;margin-bottom:8px;">1800 Series</h3>
                    <p style="color:#666;margin-bottom:20px;">Heavy duty · 4–7 panels</p>
                    <p style="font-size:28px;font-weight:800;color:#0d2764;">From $641</p>
                    <a href="/shop?search=HK-1800"
                       style="display:block;background:#0d2764;color:#fff;padding:12px;border-radius:4px;text-decoration:none;font-weight:600;margin-top:16px;">
                      Shop 1800 Kits →
                    </a>
                  </div>
                </div>
              </div>

              <div class="text-center mt-4">
                <a href="/shop?search=HK-" style="color:#0d2764;font-weight:600;font-size:16px;text-decoration:underline;">
                  View all 12 hardware kits →
                </a>
              </div>
            </div>
          </section>

          <!-- ── SHOP BY CATEGORY ───────────────────────────────────────── -->
          <section style="padding:70px 0;background:#fff;">
            <div class="container">
              <div class="text-center mb-5">
                <h2 style="font-size:36px;font-weight:800;color:#0d2764;">Shop by Category</h2>
              </div>
              <div class="row g-3">
                <t t-foreach="[
                    ('Tracks',              '/shop?categ=Tracks',              '🛤️'),
                    ('Hinges',              '/shop?categ=Hinges',              '🔩'),
                    ('Rollers',             '/shop?categ=Rollers',             '⚙️'),
                    ('Brackets',            '/shop?categ=Brackets',            '🔗'),
                    ('Drums &amp; Shaft Parts','/shop?categ=Drums+%26+Shaft+Parts','🥁'),
                    ('Lift Cables',         '/shop?categ=Lift+Cables',         '🪢'),
                    ('Locks &amp; Handles', '/shop?categ=Locks+%26+Handles',   '🔑'),
                    ('Struts',              '/shop?categ=Struts',              '📏'),
                    ('Fasteners',           '/shop?categ=Fasteners',           '🔨'),
                  ]" t-as="cat">
                  <div class="col-6 col-md-4 col-lg-3">
                    <a t-att-href="cat[1]"
                       style="display:block;background:#f8f9fa;border:2px solid #e9ecef;border-radius:10px;padding:24px 16px;text-align:center;text-decoration:none;transition:all 0.2s;"
                       onmouseover="this.style.borderColor='#0d2764';this.style.background='#f0f4ff'"
                       onmouseout="this.style.borderColor='#e9ecef';this.style.background='#f8f9fa'">
                      <div style="font-size:32px;margin-bottom:10px;"><t t-esc="cat[2]"/></div>
                      <div style="color:#0d2764;font-weight:600;font-size:15px;"><t t-esc="cat[0]"/></div>
                    </a>
                  </div>
                </t>
              </div>
            </div>
          </section>

          <!-- ── ABOUT STRIP ────────────────────────────────────────────── -->
          <section style="background:#0d2764;padding:60px 0;">
            <div class="container text-center text-white">
              <h2 style="font-size:32px;font-weight:800;margin-bottom:16px;">AA Impact Garage Door Supply</h2>
              <p style="font-size:18px;color:rgba(255,255,255,0.8);max-width:600px;margin:0 auto 32px;">
                Built to Last &amp; Designed to Impress. Serving South Florida's
                garage door industry with quality hardware from CHI and Arrow Tru-Line.
              </p>
              <div class="d-flex justify-content-center flex-wrap gap-4">
                <div>
                  <p style="font-size:13px;color:rgba(255,255,255,0.6);margin:0;">Location</p>
                  <p style="font-weight:600;margin:0;">9753 NW 91st Court, Medley FL</p>
                </div>
                <div style="border-left:1px solid rgba(255,255,255,0.2);padding-left:32px;">
                  <p style="font-size:13px;color:rgba(255,255,255,0.6);margin:0;">Hours</p>
                  <p style="font-weight:600;margin:0;">Mon–Fri 8am–5pm</p>
                </div>
                <div style="border-left:1px solid rgba(255,255,255,0.2);padding-left:32px;">
                  <p style="font-size:13px;color:rgba(255,255,255,0.6);margin:0;">Phone</p>
                  <p style="font-weight:600;margin:0;">786-238-7640</p>
                </div>
              </div>
            </div>
          </section>

        </div>
      </xpath>
    </template>

  </data>
</odoo>
