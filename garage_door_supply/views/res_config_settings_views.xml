<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!--
    Anchored on website_info_settings, which is the block
    spring_engineering already extends successfully in this database. The
    obvious-looking shop_checkout_process block does not exist in this version
    and the module refused to load against it.
  -->
  <record id="res_config_settings_view_form_track_prep" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.track.prep</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="website.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//block[@id='website_info_settings']" position="after">
        <block title="Prepared Vertical Tracks" id="track_preparation_settings">
          <setting string="Flag angle"
                   help="Added when a vertical track is ordered prepared. One per track.">
            <div class="content-group">
              <div class="mt16">
                <field name="track_prep_flag_product_id" class="oe_inline"/>
              </div>
            </div>
          </setting>
        </block>
      </xpath>
    </field>
  </record>

</odoo>
