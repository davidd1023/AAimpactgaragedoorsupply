<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ── Interlayers ──────────────────────────────────────────────────────────
         noupdate=1 so dealer-entered prices are never wiped on upgrade.
    ──────────────────────────────────────────────────────────────────────────── -->
    <record id="interlayer_clear_pvb" model="glass.door.interlayer">
        <field name="name">Clear PVB (0.030")</field>
        <field name="price_per_sqft">0.0</field>
    </record>
    <record id="interlayer_sgp" model="glass.door.interlayer">
        <field name="name">Clear SGP (Sentry)</field>
        <field name="price_per_sqft">0.0</field>
    </record>
    <record id="interlayer_bronze_pvb" model="glass.door.interlayer">
        <field name="name">Bronze PVB (0.030")</field>
        <field name="price_per_sqft">0.0</field>
    </record>

    <!-- ── Glass Types — 5/16" Tempered (Monolithic) ──────────────────────────
         Weight: ~3.27 lbs/sqft. Prices to be filled in by admin.
    ──────────────────────────────────────────────────────────────────────────── -->
    <record id="glass_516_clear" model="glass.door.glass.type">
        <field name="name">5/16" Clear Tempered</field>
        <field name="thickness">5/16</field>
        <field name="tint">clear</field>
        <field name="price_per_sqft">0.0</field>
        <field name="weight_per_sqft">3.27</field>
    </record>
    <record id="glass_516_bronze" model="glass.door.glass.type">
        <field name="name">5/16" Bronze Tempered</field>
        <field name="thickness">5/16</field>
