    <record id="glass_516_gray" model="glass.door.glass.type">
        <field name="name">5/16" Gray Tempered</field>
        <field name="thickness">5/16</field>
        <field name="tint">gray</field>
        <field name="price_per_sqft">0.0</field>
        <field name="weight_per_sqft">3.27</field>
