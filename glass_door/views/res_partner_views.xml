<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_glass_door_form" model="ir.ui.view">
        <field name="name">res.partner.glass.door.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="before">
                <page string="Dealer Info" name="dealer_info">
                    <group>
                        <field name="is_dealer"/>
                        <field name="dealer_markup" invisible="not is_dealer"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
