<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Portal Home Counter ──────────────────────────────────────────────── -->
    <template id="portal_my_home_glass_door" inherit_id="portal.portal_my_home">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">My Door Orders</t>
                <t t-set="url">/my/doors</t>
                <t t-set="count" t-value="door_count"/>
            </t>
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">My Clients</t>
                <t t-set="url">/my/clients</t>
                <t t-set="count" t-value="0"/>
            </t>
        </xpath>
    </template>

    <!-- ── Order List ────────────────────────────────────────────────────────── -->
    <template id="portal_door_list" name="My Door Orders">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Door Orders</t>
            </t>
            <t t-if="not orders">
                <div class="alert alert-info">
                    No door orders yet.
                    <a href="/my/doors/new" class="btn btn-primary ms-2">Place Your First Order</a>
                </div>
            </t>
            <t t-if="orders">
                <div class="card">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Quote #</th>
                                <th>Work Order #</th>
                                <th>Job Name</th>
                                <th>Series</th>
                                <th>Dimensions</th>
                                <th>Qty</th>
                                <th>Total</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="orders" t-as="order">
                                <tr>
                                    <td>
                                        <a t-attf-href="/my/doors/#{order.id}">
                                            <t t-esc="order.quote_number"/>
                                        </a>
                                    </td>
                                    <td><t t-esc="order.name if order.name != 'New' else '—'"/></td>
                                    <td><t t-esc="order.job_name"/></td>
                                    <td><t t-esc="order.series"/></td>
                                    <td>
                                        <t t-esc="order.frame_width"/>″ ×
                                        <t t-esc="order.frame_height"/>″
                                    </td>
                                    <td><t t-esc="order.quantity"/></td>
                                    <td>$<t t-esc="'%.2f' % order.total_price"/></td>
                                    <td>
                                        <span t-attf-class="badge #{
                                            'text-bg-secondary' if order.state == 'draft' else
                                            'text-bg-warning' if order.state == 'submitted' else
                                            'text-bg-primary' if order.state == 'approved' else
                                            'text-bg-success' if order.state in ('ready_pickup','ready_ship') else
                                            'text-bg-info'}">
                                            <t t-esc="dict(order._fields['state'].selection).get(order.state)"/>
                                        </span>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
                <div class="mt-3">
                    <a href="/my/doors/new" class="btn btn-primary">+ New Order</a>
                </div>
                <div t-if="pager" class="o_portal_pager text-center mt-3">
                    <t t-call="web.pager"><t t-set="pager" t-value="pager"/></t>
                </div>
            </t>
        </t>
    </template>

    <!-- ── New Order Form ────────────────────────────────────────────────────── -->
    <template id="portal_door_form" name="New Glass Door Order">
        <t t-call="portal.portal_layout">
            <t t-set="o_portal_fullwidth_alert" t-value="True"/>

            <!-- ── Opening Popup Modal ─────────────────────────────────────── -->
            <div class="modal fade" id="jobInfoModal" tabindex="-1"
                 data-bs-backdrop="static" data-bs-keyboard="false">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header bg-primary text-white">
                            <h5 class="modal-title">New Quote — Job Info</h5>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Job Name *</label>
                                <input type="text" id="modal_job_name" class="form-control"
                                       placeholder="e.g. Smith Residence" required="1"/>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">PO # <small class="text-muted">(optional)</small></label>
                                <input type="text" id="modal_po_number" class="form-control"
                                       placeholder="Your PO or reference number"/>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Client</label>
                                <div class="input-group">
                                    <select id="modal_client" class="form-select">
                                        <option value="">— No client / New client —</option>
                                        <t t-foreach="clients" t-as="c">
                                            <option t-att-value="c.id"
                                                    t-att-data-markup="c.markup">
                                                <t t-esc="c.name"/>
                                            </option>
                                        </t>
                                    </select>
                                    <button type="button" class="btn btn-outline-secondary"
                                            id="btn_new_client" title="Create new client">+</button>
                                </div>
                                <!-- Inline new client creation -->
                                <div id="new_client_form" class="mt-2 p-2 border rounded bg-light d-none">
                                    <input type="text" id="new_client_name" class="form-control form-control-sm"
                                           placeholder="New client name"/>
                                    <button type="button" class="btn btn-sm btn-primary mt-1"
                                            id="btn_save_new_client">Save Client</button>
                                    <button type="button" class="btn btn-sm btn-link mt-1"
                                            id="btn_cancel_new_client">Cancel</button>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Additional Job Markup (%)</label>
                                <div class="input-group">
                                    <input type="number" id="modal_job_markup" class="form-control"
                                           value="0" min="0" step="0.5"/>
                                    <span class="input-group-text">%</span>
                                </div>
                                <div class="form-text">Added on top of client's standard rate for this job.</div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <a href="/my/doors" class="btn btn-outline-secondary">Cancel</a>
                            <button type="button" class="btn btn-primary" id="btn_start_quote">
                                Continue to Quote →
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="container mt-4" style="max-width:860px">
                <h2 class="mb-1">New Glass Door Quote</h2>

                <!-- Job info summary bar (filled by modal) -->
                <div class="alert alert-light border d-flex justify-content-between align-items-center mb-4"
                     id="job_summary_bar">
                    <div>
                        <strong id="summary_job_name">—</strong>
                        <span class="text-muted ms-2" id="summary_client"></span>
                        <span class="badge text-bg-secondary ms-2" id="summary_po"></span>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            data-bs-toggle="modal" data-bs-target="#jobInfoModal">Edit</button>
                </div>

                <form action="/my/doors/submit" method="post" id="door_order_form">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="job_name" id="field_job_name"/>
                    <input type="hidden" name="po_number" id="field_po_number"/>
                    <input type="hidden" name="dealer_client_id" id="field_client_id"/>
                    <input type="hidden" name="job_markup" id="field_job_markup" value="0"/>

                    <!-- Quantity (moved here from job info) -->
                    <div class="card mb-3">
                        <div class="card-header fw-bold">Order Info</div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label class="form-label">Quantity *</label>
                                    <input type="number" name="quantity" class="form-control"
                                           value="1" min="1" required="1"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Door Specs -->
                    <div class="card mb-3">
                        <div class="card-header fw-bold">Door Specifications</div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">Series *</label>
                                    <select name="series" class="form-select" required="1">
                                        <option value="1200">Series 1200</option>
                                        <option value="1600">Series 1600</option>
                                        <option value="1800">Series 1800</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Design Pressure *</label>
                                    <select name="design_pressure" class="form-select" required="1">
                                        <option value="dp15">DP 15</option>
                                        <option value="dp20">DP 20</option>
                                        <option value="dp25">DP 25</option>
                                        <option value="dp30">DP 30</option>
                                        <option value="dp35">DP 35</option>
                                        <option value="dp40">DP 40</option>
                                        <option value="dp50">DP 50</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Frame Finish *</label>
                                    <select name="frame_finish_id" class="form-select" required="1">
                                        <option value="">— Select —</option>
                                        <t t-foreach="finishes" t-as="f">
                                            <option t-att-value="f.id">
                                                <t t-esc="f.name"/>
                                            </option>
                                        </t>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Dimensions -->
                    <div class="card mb-3">
                        <div class="card-header fw-bold">Dimensions</div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">Width (inches) *</label>
                                    <input type="number" name="frame_width" id="frame_width"
                                           class="form-control" step="0.001" min="1" required="1"/>
                                    <div class="form-text">e.g. 144 = 12'0"</div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Height (inches) *</label>
                                    <input type="number" name="frame_height" id="frame_height"
                                           class="form-control" step="0.001" min="1" required="1"/>
                                    <div class="form-text">e.g. 99.625 = 8'3⅝"</div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Lites *</label>
                                    <select name="lites" id="lites" class="form-select" required="1">
                                        <option value="1">1</option>
                                        <option value="2">2</option>
                                        <option value="3">3</option>
                                        <option value="4">4</option>
                                        <option value="5">5</option>
                                    </select>
                                </div>
                            </div>
                            <!-- Live preview -->
                            <div id="door_preview" class="mt-3 p-3 bg-light rounded d-none">
                                <div class="row text-center">
                                    <div class="col">
                                        <div class="fw-bold" id="prev_panels">—</div>
                                        <small class="text-muted">Panels</small>
                                    </div>
                                    <div class="col">
                                        <div class="fw-bold" id="prev_glass_w">—</div>
                                        <small class="text-muted">Glass Width (in)</small>
                                    </div>
                                    <div class="col">
                                        <div class="fw-bold" id="prev_glass_h">—</div>
                                        <small class="text-muted">Glass Height (in)</small>
                                    </div>
                                    <div class="col">
                                        <div class="fw-bold" id="prev_weight">—</div>
                                        <small class="text-muted">Est. Weight (lbs)</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Glass -->
                    <div class="card mb-3">
                        <div class="card-header fw-bold">Glass</div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Glass Type *</label>
                                    <select name="glass_type_id" id="glass_type_id"
                                            class="form-select" required="1">
                                        <option value="">— Select —</option>
                                        <t t-foreach="glass_types" t-as="g">
                                            <option t-att-value="g.id">
                                                <t t-esc="g.name"/> (<t t-esc="g.thickness"/>)
                                            </option>
                                        </t>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Interlayer *</label>
                                    <select name="interlayer_id" id="interlayer_id"
                                            class="form-select" required="1">
                                        <option value="">— Select —</option>
                                        <t t-foreach="interlayers" t-as="i">
                                            <option t-att-value="i.id">
                                                <t t-esc="i.name"/>
                                            </option>
                                        </t>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Options -->
                    <div class="card mb-3">
                        <div class="card-header fw-bold">Options</div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">Trim Type</label>
                                    <select name="trim_type" id="trim_type" class="form-select">
                                        <option value="pvc">PVC (Standard)</option>
                                        <option value="aluminum">Aluminum</option>
                                    </select>
                                </div>
                                <div class="col-md-4 d-flex align-items-end">
                                    <div class="form-check">
                                        <input type="checkbox" name="include_reinforcement"
                                               id="include_reinforcement" class="form-check-input"/>
                                        <label class="form-check-label" for="include_reinforcement">
                                            Add Internal Reinforcement (104)
                                            <small class="text-muted d-block">Increases design pressure</small>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Price Summary -->
                    <div class="card mb-4 border-primary">
                        <div class="card-header bg-primary text-white fw-bold">Price Summary</div>
                        <div class="card-body">
                            <div class="row text-center">
                                <div class="col-md-6">
                                    <div class="fs-5 fw-bold" id="price_unit">$—</div>
                                    <small class="text-muted">Unit Price</small>
                                </div>
                                <div class="col-md-6">
                                    <div class="fs-4 fw-bold text-primary" id="price_total">$—</div>
                                    <small class="text-muted">Total Price</small>
                                </div>
                            </div>
                            <div class="text-center mt-2">
                                <small class="text-muted" id="price_note">
                                    Fill in dimensions and glass to see your price
                                </small>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mb-5">
                        <button type="submit" class="btn btn-primary btn-lg">
                            Submit Order
                        </button>
                        <a href="/my/doors" class="btn btn-outline-secondary btn-lg">Cancel</a>
                    </div>
                </form>
            </div>

            <!-- Portal scripts: modal + price calculator -->
            <script>
                (function () {

                    /* ── MODAL HANDLING ──────────────────────────────────────── */
                    var modal = new bootstrap.Modal(document.getElementById('jobInfoModal'), {
                        backdrop: 'static', keyboard: false
                    });

                    // Auto-open on page load
                    document.addEventListener('DOMContentLoaded', function () {
                        modal.show();
                    });

                    // "Continue to Quote" button — validate then copy to hidden fields
                    document.getElementById('btn_start_quote').addEventListener('click', function () {
                        var jobName = document.getElementById('modal_job_name').value.trim();
                        if (!jobName) {
                            document.getElementById('modal_job_name').classList.add('is-invalid');
                            return;
                        }
                        document.getElementById('modal_job_name').classList.remove('is-invalid');

                        var clientSel = document.getElementById('modal_client');
                        var clientId   = clientSel.value;
                        var clientName = clientId
                            ? clientSel.options[clientSel.selectedIndex].textContent.trim()
                            : '';
                        var poNum  = document.getElementById('modal_po_number').value.trim();
                        var markup = document.getElementById('modal_job_markup').value || '0';

                        // Copy to hidden form fields
                        document.getElementById('field_job_name').value  = jobName;
                        document.getElementById('field_po_number').value = poNum;
                        document.getElementById('field_client_id').value = clientId;
                        document.getElementById('field_job_markup').value = markup;

                        // Update summary bar
                        document.getElementById('summary_job_name').textContent = jobName;
                        document.getElementById('summary_client').textContent   = clientName ? '· ' + clientName : '';
                        document.getElementById('summary_po').textContent       = poNum ? 'PO: ' + poNum : '';
                        document.getElementById('summary_po').style.display     = poNum ? '' : 'none';

                        modal.hide();
                    });

                    // Toggle inline new-client form
                    document.getElementById('btn_new_client').addEventListener('click', function () {
                        document.getElementById('new_client_form').classList.toggle('d-none');
                        document.getElementById('new_client_name').focus();
                    });
                    document.getElementById('btn_cancel_new_client').addEventListener('click', function () {
                        document.getElementById('new_client_form').classList.add('d-none');
                        document.getElementById('new_client_name').value = '';
                    });

                    // Quick-create client via AJAX
                    document.getElementById('btn_save_new_client').addEventListener('click', function () {
                        var name = document.getElementById('new_client_name').value.trim();
                        if (!name) return;

                        fetch('/my/clients/create_ajax', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-Requested-With': 'XMLHttpRequest',
                            },
                            body: JSON.stringify({jsonrpc: '2.0', method: 'call', params: {name: name}}),
                        })
                        .then(function(r) { return r.json(); })
                        .then(function(res) {
                            if (res.result &amp;&amp; res.result.id) {
                                var c = res.result;
                                var opt = document.createElement('option');
                                opt.value = c.id;
                                opt.textContent = c.name;
                                opt.dataset.markup = c.markup;
                                opt.selected = true;
                                document.getElementById('modal_client').appendChild(opt);
                                document.getElementById('new_client_form').classList.add('d-none');
                                document.getElementById('new_client_name').value = '';
                            }
                        });
                    });

                    /* ── PRICE CALCULATOR ────────────────────────────────────── */
                    var priceFields = ['frame_width', 'frame_height', 'lites', 'glass_type_id',
                                       'interlayer_id', 'trim_type', 'include_reinforcement'];

                    function getFormData() {
                        return {
                            frame_width: parseFloat(document.getElementById('frame_width').value) || 0,
                            frame_height: parseFloat(document.getElementById('frame_height').value) || 0,
                            lites: parseInt(document.getElementById('lites').value) || 1,
                            glass_type_id: parseInt(document.getElementById('glass_type_id').value) || 0,
                            interlayer_id: parseInt(document.getElementById('interlayer_id').value) || 0,
                            quantity: parseInt(document.querySelector('[name=quantity]').value) || 1,
                            series: document.querySelector('[name=series]').value,
                            design_pressure: document.querySelector('[name=design_pressure]').value,
                            frame_finish_id: parseInt(document.querySelector('[name=frame_finish_id]').value) || 0,
                            trim_type: document.getElementById('trim_type').value,
                            include_reinforcement: document.getElementById('include_reinforcement').checked,
                            job_markup: parseFloat(document.getElementById('field_job_markup').value) || 0,
                        };
                    }

                    function fmt(n) { return '$' + parseFloat(n).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }

                    function updatePrice() {
                        var data = getFormData();
                        if (!data.frame_width || !data.frame_height || !data.glass_type_id || !data.interlayer_id) {
                            return;
                        }

                        // Auto-enforce min 2 lites for wide doors
                        if (data.frame_width > 144 &amp;&amp; data.lites &lt; 2) {
                            document.getElementById('lites').value = 2;
                            data.lites = 2;
                        }

                        fetch('/my/doors/compute_price', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-Requested-With': 'XMLHttpRequest',
                            },
                            body: JSON.stringify({jsonrpc: '2.0', method: 'call', params: data}),
                        })
                        .then(function(r) { return r.json(); })
                        .then(function(res) {
                            if (res.result &amp;&amp; !res.result.error) {
                                var r = res.result;
                                document.getElementById('prev_panels').textContent = r.num_panels;
                                document.getElementById('prev_glass_w').textContent = r.glass_width + '"';
                                document.getElementById('prev_glass_h').textContent = r.glass_height + '"';
                                document.getElementById('prev_weight').textContent = r.door_weight + ' lbs';
                                document.getElementById('door_preview').classList.remove('d-none');
                                document.getElementById('price_unit').textContent = fmt(r.unit_price);
                                document.getElementById('price_total').textContent = fmt(r.total_price);
                                document.getElementById('price_note').textContent = 'Price includes your markups';
                            }
                        });
                    }

                    priceFields.forEach(function(id) {
                        var el = document.getElementById(id);
                        if (el) el.addEventListener('change', updatePrice);
                    });
                    document.querySelector('[name=quantity]').addEventListener('input', updatePrice);

                    // Form submit guard — ensure modal data was filled
                    document.getElementById('door_order_form').addEventListener('submit', function (e) {
                        if (!document.getElementById('field_job_name').value) {
                            e.preventDefault();
                            modal.show();
                        }
                    });
                })();
            </script>
        </t>
    </template>

    <!-- ── Order Detail ───────────────────────────────────────────────────────── -->
    <template id="portal_door_detail" name="Door Order Detail">
        <t t-call="portal.portal_layout">
            <t t-set="o_portal_fullwidth_alert" t-value="True"/>
            <div class="container mt-4" style="max-width:860px">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="mb-0">
                            <t t-if="order.name != 'New'">WO# <t t-esc="order.name"/></t>
                            <t t-else="">Quote <t t-esc="order.quote_number"/></t>
                        </h2>
                        <div class="text-muted">
                            Job: <strong><t t-esc="order.job_name"/></strong>
                            <t t-if="order.dealer_client_id">
                                · Client: <t t-esc="order.dealer_client_id.name"/>
                            </t>
                            <t t-if="order.po_number">
                                · PO: <t t-esc="order.po_number"/>
                            </t>
                        </div>
                    </div>
                    <span t-attf-class="badge fs-6 #{
                        'text-bg-secondary' if order.state == 'draft' else
                        'text-bg-warning' if order.state == 'submitted' else
                        'text-bg-primary' if order.state == 'approved' else
                        'text-bg-success' if order.state in ('ready_pickup','ready_ship') else
                        'text-bg-info'}">
                        <t t-esc="dict(order._fields['state'].selection).get(order.state)"/>
                    </span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-header fw-bold">Door Specifications</div>
                            <div class="card-body">
                                <table class="table table-sm mb-0">
                                    <tr><th>Series</th><td><t t-esc="order.series"/></td></tr>
                                    <tr><th>Design Pressure</th><td><t t-esc="order.design_pressure.upper()"/></td></tr>
                                    <tr><th>Width</th><td><t t-esc="order.frame_width"/>″</td></tr>
                                    <tr><th>Height</th><td><t t-esc="order.frame_height"/>″</td></tr>
                                    <tr><th>Panels</th><td><t t-esc="order.num_panels"/></td></tr>
                                    <tr><th>Lites</th><td><t t-esc="order.lites"/></td></tr>
                                    <tr><th>Frame Finish</th><td><t t-esc="order.frame_finish_id.name"/></td></tr>
                                    <tr><th>Trim</th><td><t t-esc="order.trim_type.upper()"/></td></tr>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-header fw-bold">Glass</div>
                            <div class="card-body">
                                <table class="table table-sm mb-0">
                                    <tr><th>Glass Type</th><td><t t-esc="order.glass_type_id.name"/></td></tr>
                                    <tr><th>Interlayer</th><td><t t-esc="order.interlayer_id.name"/></td></tr>
                                    <tr><th>Glass Width</th><td><t t-esc="order.glass_width"/>″</td></tr>
                                    <tr><th>Glass Height</th><td><t t-esc="order.glass_height"/>″</td></tr>
                                    <tr><th>Door Weight</th><td><t t-esc="'%.2f' % order.door_weight"/> lbs</td></tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header fw-bold">Pricing</div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col">
                                <div class="fs-5">Qty: <strong><t t-esc="order.quantity"/></strong></div>
                            </div>
                            <div class="col">
                                <div class="fs-5">Unit: <strong>$<t t-esc="'%.2f' % order.unit_price"/></strong></div>
                            </div>
                            <div class="col">
                                <div class="fs-4 text-primary fw-bold">
                                    Total: $<t t-esc="'%.2f' % order.total_price"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <a href="/my/doors" class="btn btn-outline-secondary mb-5">← Back to My Orders</a>
                <a href="/my/doors/new" class="btn btn-primary mb-5 ms-2">+ New Order</a>
            </div>
        </t>
    </template>

    <!-- ── Client List ───────────────────────────────────────────────────────── -->
    <template id="portal_client_list" name="My Clients">
        <t t-call="portal.portal_layout">
            <t t-set="o_portal_fullwidth_alert" t-value="True"/>
            <div class="container mt-4" style="max-width:860px">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="mb-0">My Clients</h2>
                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#clientModal"
                            id="btn_add_client">+ Add Client</button>
                </div>

                <t t-if="not clients">
                    <div class="alert alert-info">
                        No clients yet. Add your first client to save their markup for future quotes.
                    </div>
                </t>

                <t t-if="clients">
                    <div class="card mb-4">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Client Name</th>
                                    <th>Phone</th>
                                    <th>Email</th>
                                    <th>Markup</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="clients" t-as="c">
                                    <tr>
                                        <td><strong><t t-esc="c.name"/></strong></td>
                                        <td><t t-esc="c.phone or '—'"/></td>
                                        <td><t t-esc="c.email or '—'"/></td>
                                        <td><t t-esc="'%.1f' % c.markup"/>%</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-secondary btn-edit-client"
                                                    t-att-data-id="c.id"
                                                    t-att-data-name="c.name"
                                                    t-att-data-markup="c.markup"
                                                    t-att-data-phone="c.phone or ''"
                                                    t-att-data-email="c.email or ''"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#clientModal">Edit</button>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>

                <a href="/my/doors" class="btn btn-outline-secondary">← My Orders</a>
            </div>

            <!-- Client Edit/Create Modal -->
            <div class="modal fade" id="clientModal" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="clientModalTitle">Client Details</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"/>
                        </div>
                        <form action="/my/clients/save" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="client_id" id="edit_client_id" value="0"/>
                            <div class="modal-body">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Client Name *</label>
                                    <input type="text" name="name" id="edit_name"
                                           class="form-control" required="1"/>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Markup (%)</label>
                                    <div class="input-group">
                                        <input type="number" name="markup" id="edit_markup"
                                               class="form-control" step="0.5" min="0" value="0"/>
                                        <span class="input-group-text">%</span>
                                    </div>
                                    <div class="form-text">
                                        This markup is private — only visible here when editing.
                                    </div>
                                </div>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Phone</label>
                                        <input type="text" name="phone" id="edit_phone"
                                               class="form-control" placeholder="Optional"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Email</label>
                                        <input type="email" name="email" id="edit_email"
                                               class="form-control" placeholder="Optional"/>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary"
                                        data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-primary">Save Client</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <script>
                (function () {
                    // Populate modal when editing
                    document.querySelectorAll('.btn-edit-client').forEach(function (btn) {
                        btn.addEventListener('click', function () {
                            document.getElementById('clientModalTitle').textContent = 'Edit Client';
                            document.getElementById('edit_client_id').value = btn.dataset.id;
                            document.getElementById('edit_name').value     = btn.dataset.name;
                            document.getElementById('edit_markup').value   = btn.dataset.markup;
                            document.getElementById('edit_phone').value    = btn.dataset.phone;
                            document.getElementById('edit_email').value    = btn.dataset.email;
                        });
                    });
                    // Reset for "Add Client"
                    document.getElementById('btn_add_client').addEventListener('click', function () {
                        document.getElementById('clientModalTitle').textContent = 'New Client';
                        document.getElementById('edit_client_id').value = '0';
                        document.getElementById('edit_name').value      = '';
                        document.getElementById('edit_markup').value    = '0';
                        document.getElementById('edit_phone').value     = '';
                        document.getElementById('edit_email').value     = '';
                    });
                })();
            </script>
        </t>
    </template>

</odoo>
