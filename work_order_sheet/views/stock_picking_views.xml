<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- THE DELIVERY CONFIRMATION, ON THE ORDER IT BELONGS TO.

       The work station blocks that used to live beside these moved to
       work_station_picking_views.xml, which is not loaded: the owner put the
       benches away in favour of the shop floor module, and asked for this form
       to stay. It never depended on them - it hangs off the outgoing transfer
       and the customer's own link.

       The record ids still read work_stations because renaming an xml id
       renames nothing in a database that already has it: the view would be
       loaded twice, once under each name. They keep the name they were born
       with. -->
  <record id="view_picking_form_work_stations" model="ir.ui.view">
    <field name="name">stock.picking.form.work.stations</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form"/>
    <field name="arch" type="xml">

      <!-- THE DEALER'S NOTE, ON THE TAB HE POINTED AT (owner, 2026-10-30,
           with a screenshot of W/O #299: "i dont see the note, could you put
           it on this tab").

           ABOVE Odoo's own note and READ-ONLY. Writing the order's note into
           `stock.picking.note` would have put the words on this tab too, and
           then there would be two of them: a copy going stale the moment the
           office corrects the order, and no way to tell whose words were
           whose once somebody typed their own remark underneath. The
           transfer's note stays the shop's to write in. -->
      <xpath expr="//page[@name='note']/field[@name='note']" position="before">
        <div class="alert alert-info" role="status"
             invisible="not aa_order_note">
          <strong>From the dealer's order</strong>
          <field name="aa_order_note" nolabel="1" readonly="1"/>
        </div>
      </xpath>

      <!-- THE DEALER'S PO, BESIDE OUR OWN REFERENCE (owner, 2026-10-29:
           "can you make the po visible on the work order page"). Next to the
           Source Document on purpose: they are the same fact told twice, his
           name for this order and ours, and somebody holding his email needs
           to see both at once. Hidden when there is none, because a website
           order has no reference and an empty box invites somebody to fill
           it in. -->
      <xpath expr="//field[@name='origin']" position="after">
        <field name="aa_po_number" invisible="not aa_po_number"/>
      </xpath>

      <!-- THE DELIVERY NOTE THAT SIGNS ITSELF BACK, on the order it belongs
           to: the link to hand the driver, when the form was made, and what
           came back. -->
      <xpath expr="//notebook" position="before">
        <group string="Delivery confirmation" name="dispatch_confirmation"
               invisible="picking_type_code != 'outgoing'">
          <group>
            <field name="dispatch_state" widget="badge"
                   decoration-success="dispatch_state == 'signed'"
                   decoration-warning="dispatch_state == 'open'"
                   invisible="not dispatch_state"/>
            <field name="dispatch_form_date" invisible="not dispatch_form_date"/>
            <field name="dispatch_signed_by" invisible="not dispatch_signed_on"/>
            <field name="dispatch_signed_on" invisible="not dispatch_signed_on"/>
            <button name="action_dispatch_form" type="object" class="btn-link"
                    string="Make the confirmation form"
                    invisible="dispatch_state"/>
            <!-- WHEN THE CUSTOMER WAS TOLD, and what address it went to, so
                 nobody has to guess whether it has been done and nobody
                 tells them twice by accident. -->
            <field name="dispatch_ready_sent_on" invisible="not dispatch_ready_sent_on"/>
            <field name="dispatch_ready_sent_to" invisible="not dispatch_ready_sent_on"/>
          </group>
          <group>
            <!-- The link itself stays on the record but off the form: the button
                 below opens it (owner, 2026-10-14). -->
            <field name="dispatch_url" invisible="1"/>
            <button name="action_open_dispatch_form" type="object" class="btn btn-primary"
                    icon="fa-external-link" string="Open the confirmation form"
                    invisible="not dispatch_state" colspan="2"/>
            <!-- THE DECISION IS THE PRESS (owner, 2026-10-19): the alert goes
                 when somebody says the order is really ready, not when the
                 last box happens to be ticked. The words change once it has
                 gone, because sending it twice should be a thing somebody
                 means to do. -->
            <button name="action_notify_ready" type="object" class="btn btn-secondary"
                    icon="fa-envelope-o" string="Tell the customer it's ready"
                    invisible="dispatch_ready_sent_on" colspan="2"/>
            <button name="action_notify_ready" type="object" class="btn btn-link"
                    icon="fa-repeat" string="Tell the customer again"
                    invisible="not dispatch_ready_sent_on" colspan="2"/>
            <field name="dispatch_signature" widget="image"
                   options="{'size': [0, 90]}"
                   invisible="not dispatch_signed_on"/>
          </group>
        </group>
      </xpath>

    </field>
  </record>

  <!-- AND IN THE LIST, so the one order the floor is still working on can be
       found without opening any of them. Optional columns: this is the shop's
       own question, not every warehouse's. -->
  <record id="vpicktree_work_stations" model="ir.ui.view">
    <field name="name">stock.picking.list.work.stations</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.vpicktree"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='state']" position="before">
        <!-- NOT `optional`. An `optional="show"` column is shown only to
             somebody who has never touched that list's column chooser, and
             anybody who has keeps the set they saved - so a column added
             afterwards arrives HIDDEN behind the toggle at the right-hand
             end. He has touched this list; it already carries Dispatched and
             the station badges. The pickup column cost a round of exactly
             this. -->
        <field name="aa_po_number"/>
        <field name="dispatch_state" optional="show" widget="badge"
               decoration-success="dispatch_state == 'signed'"
               decoration-warning="dispatch_state == 'open'"/>
      </xpath>
    </field>
  </record>

  <record id="view_picking_internal_search_work_stations" model="ir.ui.view">
    <field name="name">stock.picking.search.work.stations</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_internal_search"/>
    <field name="arch" type="xml">
      <xpath expr="//search" position="inside">
        <!-- TYPE HIS PO INTO THE SEARCH BOX. A dealer telephones about
             PO-44821 and nobody here knows which of ours that is; this is
             the whole reason the field is stored rather than computed on the
             fly. -->
        <field name="aa_po_number" string="PO Number"/>
        <filter name="dispatch_unsigned" string="Not signed for"
                domain="[('dispatch_state', '=', 'open')]"/>
      </xpath>
    </field>
  </record>

</odoo>
