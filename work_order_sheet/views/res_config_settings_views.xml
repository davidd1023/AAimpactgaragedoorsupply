<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- WHICH OF OUR ADDRESSES SENDS THE ALERT (owner, 2026-10-19), in
       Inventory > Settings beside the delivery it belongs to. Not in
       Technical > Parameters, which is where a system parameter would
       otherwise have to be edited, and not in the code. -->
  <record id="res_config_settings_view_form_dispatch" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.work.order.sheet</field>
    <field name="model">res.config.settings</field>
    <field name="priority" eval="40"/>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//block[@name='operations_setting_container']" position="after">
        <block title="Delivery Confirmation" name="aa_dispatch_setting_container">
          <setting id="aa_ready_email_from"
                   string="Order-ready alerts"
                   help="The address the &quot;your order is ready&quot; email is sent from, and the one a customer's reply comes back to. Left empty, the company's own email address is used.">
            <field name="dispatch_ready_email_auto"/>
            <div class="content-group mt-2">
              <label for="dispatch_ready_email_from" string="Sent from" class="o_light_label"/>
              <field name="dispatch_ready_email_from" placeholder="sales@aaigd.com"/>
            </div>
          </setting>
          <setting id="aa_pickup_hours"
                   string="Pickup hours"
                   help="Printed on every email the customer gets - the order confirmation, the invoice, &quot;ready for pickup&quot; and the cancellation - under the address they collect from.">
            <div class="content-group mt-2">
              <field name="aa_pickup_hours" placeholder="Monday to Friday, 8:00 AM to 4:30 PM"/>
            </div>
          </setting>
        </block>
      </xpath>
    </field>
  </record>

</odoo>
