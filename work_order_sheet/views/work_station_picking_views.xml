<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- THE WORK STATIONS, PUT AWAY FOR NOW.

       The owner's instruction, 2026-10-14: the shop floor module does the same
       job, so the four benches are not needed at the moment - and the delivery
       confirmation form, which lives on the transfer and has nothing to do
       with them, stays exactly where it is.

       Nothing here is deleted. This file is simply not listed in
       __manifest__.py, so none of it loads; a migration archives the records
       an installed database already has. Putting the benches back is this file
       back in the manifest and those records unarchived.

       The records below were lifted out of stock_picking_views.xml, which now
       carries the delivery confirmation and nothing else. -->

  <record id="view_picking_form_work_stations_parts" model="ir.ui.view">
    <field name="name">stock.picking.form.work.stations.parts</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form"/>
    <field name="arch" type="xml">

      <!-- SAID WHERE IT MATTERS. An order whose work is sorted but which no
           bench can see looks, on this screen, exactly like one they are
           working on. -->
      <xpath expr="//notebook" position="before">
        <div class="alert alert-info" role="status"
             invisible="work_station_released or (work_station_springs == 'none' and work_station_tracks == 'none' and work_station_cables == 'none' and work_station_dispatch == 'none')">
          This order is not on the work stations yet - the benches cannot see
          it until it is sent to them.
          <button name="action_work_station_release" type="object"
                  string="Send to the work stations" class="btn-link"/>
        </div>
      </xpath>


      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="action_open_work_station_items" type="object"
                class="oe_stat_button" icon="fa-wrench"
                invisible="work_station_springs == 'none' and work_station_tracks == 'none' and work_station_cables == 'none' and work_station_dispatch == 'none'">
          <field name="work_station_todo_count" widget="statinfo"
                 string="To make"/>
        </button>
      </xpath>


      <xpath expr="//notebook" position="before">
        <group string="Work stations" name="work_stations"
               invisible="work_station_springs == 'none' and work_station_tracks == 'none' and work_station_cables == 'none' and work_station_dispatch == 'none'">
          <group>
            <field name="work_station_shown" widget="badge"
                   decoration-success="work_station_shown == 'yes'"
                   decoration-warning="work_station_shown == 'no'"
                   decoration-muted="work_station_shown == 'done'"/>
            <field name="work_station_springs" widget="badge"
                   invisible="work_station_springs == 'none'"
                   decoration-success="work_station_springs == 'done'"
                   decoration-warning="work_station_springs == 'partial'"
                   decoration-info="work_station_springs == 'todo'"/>
            <field name="work_station_tracks" widget="badge"
                   invisible="work_station_tracks == 'none'"
                   decoration-success="work_station_tracks == 'done'"
                   decoration-warning="work_station_tracks == 'partial'"
                   decoration-info="work_station_tracks == 'todo'"/>
            <field name="work_station_cables" widget="badge"
                   invisible="work_station_cables == 'none'"
                   decoration-success="work_station_cables == 'done'"
                   decoration-warning="work_station_cables == 'partial'"
                   decoration-info="work_station_cables == 'todo'"/>
            <!-- LAST, AND SHOWN AS WAITING UNTIL THE OTHERS ARE DONE, which
                 is the one thing the office asks about an order that looks
                 finished but has not gone out. -->
            <field name="work_station_dispatch" widget="badge"
                   invisible="work_station_dispatch == 'none'"
                   decoration-success="work_station_dispatch == 'done'"
                   decoration-warning="work_station_dispatch == 'partial'"
                   decoration-info="work_station_dispatch == 'todo'"/>
            <field name="work_station_waiting_for"
                   invisible="work_station_dispatch in ('none', 'done') or not work_station_waiting_for"/>
          </group>
        </group>
      </xpath>


    </field>
  </record>

  <record id="vpicktree_work_stations_parts" model="ir.ui.view">
    <field name="name">stock.picking.list.work.stations.parts</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.vpicktree"/>
    <field name="arch" type="xml">

      <!-- THE BUTTONS GO WHERE UNRESERVE AND CHECK AVAILABILITY ALREADY ARE:
           the row that appears across the top once orders are ticked, which is
           where somebody standing in this list looks for something to do to
           the orders they have just chosen. -->
      <xpath expr="//list/header" position="inside">
        <button name="action_work_station_release" type="object"
                string="Send to work stations"/>
        <button name="action_work_station_withdraw" type="object"
                string="Take off work stations"/>
      </xpath>


      <xpath expr="//field[@name='state']" position="before">
        <field name="work_station_shown" optional="show" widget="badge"
               decoration-success="work_station_shown == 'yes'"
               decoration-warning="work_station_shown == 'no'"
               decoration-muted="work_station_shown == 'done'"/>
        <field name="work_station_springs" optional="hide" widget="badge"
               decoration-success="work_station_springs == 'done'"
               decoration-warning="work_station_springs == 'partial'"
               decoration-info="work_station_springs == 'todo'"
               decoration-muted="work_station_springs == 'none'"/>
        <field name="work_station_tracks" optional="hide" widget="badge"
               decoration-success="work_station_tracks == 'done'"
               decoration-warning="work_station_tracks == 'partial'"
               decoration-info="work_station_tracks == 'todo'"
               decoration-muted="work_station_tracks == 'none'"/>
        <field name="work_station_cables" optional="hide" widget="badge"
               decoration-success="work_station_cables == 'done'"
               decoration-warning="work_station_cables == 'partial'"
               decoration-info="work_station_cables == 'todo'"
               decoration-muted="work_station_cables == 'none'"/>
        <field name="work_station_dispatch" optional="hide" widget="badge"
               decoration-success="work_station_dispatch == 'done'"
               decoration-warning="work_station_dispatch == 'partial'"
               decoration-info="work_station_dispatch == 'todo'"
               decoration-muted="work_station_dispatch == 'none'"/>
      </xpath>

    </field>
  </record>

  <record id="view_picking_internal_search_work_stations_parts" model="ir.ui.view">
    <field name="name">stock.picking.search.work.stations.parts</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_internal_search"/>
    <field name="arch" type="xml">
      <xpath expr="//search" position="inside">
        <filter name="work_station_released" string="On the work stations"
                domain="[('work_station_released', '=', True)]"/>
        <filter name="work_station_unfinished" string="Benches unfinished"
                domain="[('work_station_todo_count', '>', 0)]"/>
      </xpath>
    </field>
  </record>

</odoo>
