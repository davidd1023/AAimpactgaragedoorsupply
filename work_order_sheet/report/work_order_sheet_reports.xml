<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_work_order_sheet" model="ir.actions.report">
        <field name="name">Work Order Sheet</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">work_order_sheet.report_work_order_sheet</field>
        <field name="report_file">work_order_sheet.report_work_order_sheet</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Work Order - %s' % (object.name)</field>
    </record>

    <!-- THE SAME CONFIRMATION, ON PAPER, FROM THE OFFICE.
         The customer's copy is the web form; this is the one the shop
         prints from the dispatch page - Print > Delivery Confirmation -
         when somebody wants it filed, posted, or carried out unsigned to be
         signed by hand. It reads from the same _dispatch_groups the form
         does, so the two cannot drift apart. -->
    <record id="action_report_delivery_confirmation" model="ir.actions.report">
        <field name="name">Delivery Confirmation</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">work_order_sheet.report_delivery_confirmation</field>
        <field name="report_file">work_order_sheet.report_delivery_confirmation</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Delivery Confirmation - %s' % (object.name)</field>
    </record>

    <template id="report_delivery_confirmation">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="article" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id">
                    <t t-set="cell" t-value="'border-bottom:1px solid #ddd;padding:6px 8px;'"/>

                    <div style="border-bottom:2px solid #000;padding-bottom:8px;margin-bottom:12px;">
                        <h2 style="margin:0;">
                            <t t-esc="o.company_id.name"/>
                        </h2>
                        <div style="font-size:14px;">
                            <t t-if="o.aa_wo_number"><b><t t-esc="o.aa_wo_number"/></b> - </t>
                            Delivery <b><t t-esc="o.name"/></b>
                            <t t-if="o.origin and not o.aa_wo_number"> - order <t t-esc="o.origin"/></t>
                        </div>
                        <!-- THE DEALER'S PO ON THE SHEET HE SIGNS. He asked
                             for it on the work order; this is the form that
                             goes back with him, and a PO is what a dealer
                             reconciles a delivery against. One line to drop
                             if it is ever unwanted. -->
                        <div t-if="o._work_order_po_number()" style="font-size:14px;margin-top:2px;">
                            PO <b><t t-esc="o._work_order_po_number()"/></b>
                        </div>
                    </div>

                    <table style="width:100%;margin-bottom:12px;font-size:12px;">
                        <tr>
                            <td>Delivered to
                                <b><t t-esc="o.partner_id.name or ''"/></b>
                            </td>
                            <td>Form made
                                <b><t t-esc="o._dispatch_date(o.dispatch_form_date)"/></b>
                            </td>
                            <td>Signed
                                <b>
                                    <t t-if="o.dispatch_signed_on">
                                        <t t-esc="o._dispatch_date(o.dispatch_signed_on)"/>
                                    </t>
                                    <t t-else="">Not yet</t>
                                </b>
                            </td>
                        </tr>
                    </table>

                    <t t-foreach="o._dispatch_groups()" t-as="group">
                        <h4 style="margin:12px 0 4px;text-transform:uppercase;
                                   font-size:12px;letter-spacing:.04em;">
                            <t t-esc="group[0]"/>
                        </h4>
                        <table style="width:100%;border-collapse:collapse;font-size:12px;">
                            <t t-foreach="group[1]" t-as="item">
                                <tr>
                                    <!-- UNSIGNED, IT IS A FORM: an empty box to
                                         tick in the van. Signed, it is a record
                                         of what was said at the door. -->
                                    <td t-att-style="cell" style="width:90px;">
                                        <t t-if="o.dispatch_signed_on">
                                            <b t-if="item['received']">Confirmed</b>
                                            <b t-else="">NOT CONFIRMED</b>
                                        </t>
                                        <t t-else="">
                                            <span style="display:inline-block;width:14px;
                                                         height:14px;border:1px solid #333;"/>
                                        </t>
                                    </td>
                                    <td t-att-style="cell" style="width:70px;text-align:right;">
                                        <b t-esc="'%g' % item['quantity']"/>
                                        <t t-esc="item['uom']"/>
                                    </td>
                                    <td t-att-style="cell"><t t-esc="item['name']"/></td>
                                </tr>
                            </t>
                        </table>
                    </t>

                    <div style="margin-top:18px;page-break-inside:avoid;">
                        <t t-if="o.dispatch_signature">
                            <img t-att-src="image_data_uri(o.dispatch_signature)"
                                 style="max-height:110px;border-bottom:1px solid #888;"/>
                        </t>
                        <t t-else="">
                            <div style="height:70px;border-bottom:1px solid #888;width:60%;"/>
                        </t>
                        <div style="font-size:12px;margin-top:4px;">
                            <t t-if="o.dispatch_signed_by">
                                Signed by <b><t t-esc="o.dispatch_signed_by"/></b>
                                on <t t-esc="o._dispatch_date(o.dispatch_signed_on)"/>
                            </t>
                            <t t-else="">Signature and name</t>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <template id="report_work_order_sheet">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <!-- One article per work order, so printing several from the
                     list gives one sheet each rather than a single run-on
                     document. -->
                <div class="article" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id">
                    <t t-set="td" t-value="'border:1px solid #888;padding:7px 12px;'"/>
                    <t t-set="th" t-value="'border:1px solid #888;padding:7px 12px;background:#1B2A6B;color:#fff;'"/>
                    <t t-set="sections" t-value="o._work_order_sections()"/>
                    <!-- THE DOOR THIS ORDER IS FOR. Computed once and printed
                         on every page, because a track cutter holding the
                         tracks page is cutting for that same door. Only the
                         facts the customer actually gave appear. -->
                    <t t-set="door" t-value="o._work_order_door()"/>
                    <t t-set="lines" t-value="o._work_order_lines()"/>
                    <!-- SET HERE, with the rest, and not inside the cover:
                         the station pages are siblings of it and a `t-set`
                         buried in one of them is in scope for the others by
                         luck rather than by rule. -->
                    <t t-set="po" t-value="o._work_order_po_number()"/>

                    <!-- PLAIN ASCII THROUGHOUT. wkhtmltopdf renders these pages
                         as Latin-1 whatever the charset says, so a non-breaking
                         space and an em dash both print as rubbish. Learned on
                         a sheet that reached the owner's hand. -->
                    <!-- THE COVER. Who it is for, which order, when it is
                         due, and everything on it at a glance - so the sheet
                         can be read before it is split up and handed out. -->
                    <div class="page" style="font-family:Arial,sans-serif;">
                        <div style="background:#1B2A6B;color:#fff;text-align:center;font-size:18px;font-weight:800;letter-spacing:.1em;padding:8px 0;border-bottom:4px solid #C0272D;">WORK ORDER</div>
                        <div style="text-align:center;margin:14px 0 2px;font-size:34px;font-weight:800;color:#1B2A6B;">
                            <span t-field="o.name"/>
                        </div>
                        <div t-if="o.aa_wo_number and o.aa_wo_number != o.name" style="text-align:center;margin:0 0 2px;font-size:22px;font-weight:800;color:#1B2A6B;">
                            <t t-esc="o.aa_wo_number"/>
                        </div>
                        <div t-if="o.origin" style="text-align:center;margin:0 0 2px;font-size:15px;color:#666;">
                            Order <strong t-esc="o.origin"/>
                        </div>
                        <!-- THE DEALER'S OWN PO (owner, 2026-10-29). It is
                             how the dealer refers to this order on his end,
                             so it is what he quotes on the telephone and what
                             his invoice has to match. Printed in the shop's
                             own red, because on a counter full of paper it is
                             the one number somebody is looking for.
                             A website order has no reference and prints
                             nothing - an empty label is worse than a gap. -->
                        <div t-if="po" style="text-align:center;margin:0 0 20px;font-size:17px;font-weight:800;color:#C0272D;">
                            PO <t t-esc="po"/>
                        </div>
                        <div t-if="not po and o.origin" style="margin:0 0 18px;"/>

                        <table style="border-collapse:collapse;width:100%;font-size:14px;margin-bottom:20px;">
                            <tr>
                                <td style="width:50%;vertical-align:top;padding:0 16px 0 0;">
                                    <div style="font-weight:800;font-size:12px;color:#1B2A6B;letter-spacing:.06em;border-bottom:2px solid #C0272D;padding-bottom:3px;margin-bottom:6px;">CUSTOMER</div>
                                    <div t-if="o.partner_id" style="font-size:15px;font-weight:700;" t-esc="o.partner_id.display_name"/>
                                    <div t-if="o.partner_id" style="color:#444;" t-field="o.partner_id.contact_address"/>
                                    <div t-if="o.partner_id.phone" style="color:#444;">Tel: <t t-esc="o.partner_id.phone"/></div>
                                    <div t-if="not o.partner_id" style="color:#666;">No customer on this order.</div>
                                </td>
                                <td style="width:50%;vertical-align:top;">
                                    <div style="font-weight:800;font-size:12px;color:#1B2A6B;letter-spacing:.06em;border-bottom:2px solid #C0272D;padding-bottom:3px;margin-bottom:6px;">WHEN</div>
                                    <table style="border-collapse:collapse;font-size:14px;">
                                        <tr t-if="o.date_deadline">
                                            <td style="padding:2px 16px 2px 0;color:#666;">Deadline</td>
                                            <td style="padding:2px 0;font-weight:800;color:#C0272D;font-size:16px;">
                                                <span t-field="o.date_deadline" t-options="{'widget': 'date'}"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding:2px 16px 2px 0;color:#666;">Scheduled</td>
                                            <td style="padding:2px 0;font-weight:700;">
                                                <span t-field="o.scheduled_date" t-options="{'widget': 'date'}"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding:2px 16px 2px 0;color:#666;">Operation</td>
                                            <td style="padding:2px 0;" t-esc="o.picking_type_id.display_name"/>
                                        </tr>
                                        <tr>
                                            <td style="padding:2px 16px 2px 0;color:#666;">State</td>
                                            <td style="padding:2px 0;font-weight:700;" t-esc="dict(o._fields['state'].selection).get(o.state, o.state)"/>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <div style="font-weight:800;font-size:12px;color:#1B2A6B;letter-spacing:.06em;border-bottom:2px solid #C0272D;padding-bottom:3px;margin-bottom:6px;">EVERYTHING ON THIS ORDER</div>
                        <p t-if="not lines" style="font-size:15px;">
                            There is nothing on this work order yet.
                        </p>
                        <table t-if="lines" style="border-collapse:collapse;width:100%;font-size:13px;">
                            <tr>
                                <th t-att-style="th + 'text-align:left;'">Category</th>
                                <th t-att-style="th + 'text-align:left;'">Code</th>
                                <th t-att-style="th + 'text-align:left;'">Product</th>
                                <th t-att-style="th + 'text-align:right;'">Length</th>
                                <th t-att-style="th + 'text-align:right;'">Qty</th>
                                <th t-att-style="th + 'text-align:left;'">Stock</th>
                            </tr>
                            <t t-foreach="sections" t-as="section">
                                <tr t-foreach="section['lines']" t-as="line"
                                    t-att-style="'background:#f8f9fa;' if line_index % 2 == 0 else ''">
                                    <td t-att-style="td" t-esc="section['title']"/>
                                    <td t-att-style="td" t-esc="line['code']"/>
                                    <td t-att-style="td" t-esc="line['name']"/>
                                    <td t-att-style="td + 'text-align:right;font-weight:700;white-space:nowrap;'">
                                        <t t-if="line['length']" t-esc="line['length']"/>
                                        <t t-else="">-</t>
                                    </td>
                                    <td t-att-style="td + 'text-align:right;font-weight:700;'" t-esc="'%g' % line['quantity']"/>
                                    <td t-att-style="td + ('font-weight:800;color:#C0272D;' if line['short'] else 'color:#666;')"
                                        t-esc="line['availability']"/>
                                </tr>
                            </t>
                        </table>

                        <div t-if="lines" style="margin-top:14px;font-size:13px;color:#666;border-top:1px solid #ccc;padding-top:8px;">
                            <t t-esc="len(sections)"/> categor<t t-if="len(sections) != 1">ies</t><t t-else="">y</t>,
                            <t t-esc="len(lines)"/> line<t t-if="len(lines) != 1">s</t>,
                            <t t-esc="'%g' % sum(l['quantity'] for l in lines)"/> item<t t-if="sum(l['quantity'] for l in lines) != 1">s</t> in all.
                            <span style="float:right;">
                                Printed <t t-esc="o._work_order_printed_at()"/>
                            </span>
                        </div>
                    </div>

                    <!-- A PAGE PER STATION. The cover is read once and the
                         pages behind it are handed out, so each one repeats the
                         order number and the deadline - a sheet on its own at a
                         bench has to say what it belongs to. -->
                    <div t-foreach="sections" t-as="section" class="page"
                         style="font-family:Arial,sans-serif;page-break-before:always;">
                        <div style="background:#1B2A6B;color:#fff;text-align:center;font-size:18px;font-weight:800;letter-spacing:.1em;padding:8px 0;border-bottom:4px solid #C0272D;">
                            <t t-esc="section['title'].upper()"/>
                        </div>
                        <div style="text-align:center;margin:8px 0 14px;font-size:13px;color:#666;">
                            <strong style="font-size:16px;color:#1B2A6B;" t-esc="o.name"/>
                            <t t-if="o.origin"> | Order <t t-esc="o.origin"/></t>
                            <!-- ON EVERY STATION PAGE TOO, for the same reason
                                 the door is: the sheet gets split up and handed
                                 out, and a page on its own has to say which
                                 order it belongs to in the dealer's words as
                                 well as ours. -->
                            <t t-if="po"> | <strong style="color:#C0272D;">PO <t t-esc="po"/></strong></t>
                            <t t-if="o.partner_id"> | <t t-esc="o.partner_id.display_name"/></t>
                            <t t-if="o.date_deadline"> | Due <span t-field="o.date_deadline" t-options="{'widget': 'date'}"/></t>
                            <t t-if="door.get('width') and door.get('height')">
                                | <strong style="color:#1B2A6B;"><t t-esc="door['width']"/> x <t t-esc="door['height']"/></strong>
                            </t>
                            <t t-elif="door.get('height')">
                                | <strong style="color:#1B2A6B;"><t t-esc="door['height']"/> high</strong>
                            </t>
                            <t t-elif="door.get('width')">
                                | <strong style="color:#1B2A6B;"><t t-esc="door['width']"/> wide</strong>
                            </t>
                            <t t-if="door.get('weight')">
                                | <strong style="color:#1B2A6B;"><t t-esc="door['weight']"/></strong>
                            </t>
                            <t t-if="door.get('hilift')">
                                | <strong style="color:#C0272D;"><t t-esc="door['hilift']"/> hi-lift</strong>
                            </t>
                        </div>

                        <table style="border-collapse:collapse;width:100%;font-size:14px;">
                            <tr>
                                <th t-att-style="th + 'text-align:left;'">Code</th>
                                <th t-att-style="th + 'text-align:left;'">Product</th>
                                <th t-att-style="th + 'text-align:right;'">Length</th>
                                <th t-att-style="th + 'text-align:right;'">Qty</th>
                                <th t-att-style="th + 'text-align:left;'">Unit</th>
                                <th t-att-style="th + 'text-align:left;'">Stock</th>
                            </tr>
                            <t t-foreach="section['lines']" t-as="line">
                                <tr t-att-style="'background:#f8f9fa;' if line_index % 2 == 0 else ''">
                                    <td t-att-style="td" t-esc="line['code']"/>
                                    <td t-att-style="td" t-esc="line['name']"/>
                                    <td t-att-style="td + 'text-align:right;font-weight:800;color:#C0272D;white-space:nowrap;'">
                                        <t t-if="line['length']" t-esc="line['length']"/>
                                        <t t-else="">-</t>
                                    </td>
                                    <td t-att-style="td + 'text-align:right;font-weight:700;'" t-esc="'%g' % line['quantity']"/>
                                    <td t-att-style="td" t-esc="line['uom']"/>
                                    <td t-att-style="td + ('font-weight:800;color:#C0272D;' if line['short'] else 'color:#666;')"
                                        t-esc="line['availability']"/>
                                </tr>
                                <tr t-if="line['spring']">
                                    <td t-att-style="td" colspan="6">
                                        <!-- BIG ENOUGH TO READ AT A BENCH. This
                                             block was set at 12 and 13 pixels
                                             because it sits inside a table row,
                                             not because anybody has to read it
                                             at arm's length under a light. It
                                             is the part somebody winds from, so
                                             it is now the largest thing on the
                                             page rather than the smallest. -->
                                        <div style="border-left:5px solid #C0272D;padding:12px 0 8px 16px;margin-top:4px;">
                                            <div style="font-weight:800;font-size:14px;color:#1B2A6B;letter-spacing:.08em;margin-bottom:10px;">SPRING ASSEMBLY</div>
                                            <!-- NO BORDERS ON THE FACTS. They
                                                 were boxed by the report's own
                                                 stylesheet and the values had
                                                 no padding on the right, so
                                                 "Single" and "10,000" sat hard
                                                 against the line. A label and
                                                 a value do not need a box. -->
                                            <table style="border-collapse:collapse;font-size:15px;margin-bottom:14px;">
                                                <tr t-foreach="line['spring']['parameters']" t-as="row">
                                                    <td style="border:0;padding:3px 26px 3px 0;color:#555;white-space:nowrap;" t-esc="row[0]"/>
                                                    <td style="border:0;padding:3px 0;font-weight:800;color:#1B2A6B;white-space:nowrap;" t-esc="row[1]"/>
                                                </tr>
                                            </table>
                                            <table style="border-collapse:collapse;font-size:16px;">
                                                <tr>
                                                    <th t-att-style="th + 'text-align:left;padding:6px 16px;font-size:13px;'">Position</th>
                                                    <th t-att-style="th + 'text-align:right;padding:6px 16px;font-size:13px;'">Wire</th>
                                                    <th t-att-style="th + 'text-align:right;padding:6px 16px;font-size:13px;'">Inside Dia.</th>
                                                    <th t-att-style="th + 'text-align:right;padding:6px 16px;font-size:13px;'">Length</th>
                                                </tr>
                                                <tr t-foreach="line['spring']['springs']" t-as="sp">
                                                    <td style="border:1px solid #888;padding:6px 16px;font-weight:700;white-space:nowrap;" t-esc="sp['role']"/>
                                                    <td style="border:1px solid #888;padding:6px 16px;text-align:right;font-weight:800;white-space:nowrap;" t-esc="sp['wire']"/>
                                                    <td style="border:1px solid #888;padding:6px 16px;text-align:right;font-weight:800;white-space:nowrap;" t-esc="sp['inside_diameter']"/>
                                                    <td style="border:1px solid #888;padding:6px 16px;text-align:right;font-weight:800;color:#C0272D;font-size:18px;white-space:nowrap;" t-esc="sp['length']"/>
                                                </tr>
                                            </table>
                                        </div>
                                    </td>
                                </tr>
                            </t>
                        </table>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
