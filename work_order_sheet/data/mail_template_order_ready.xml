<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- "YOUR ORDER IS READY", and not a word more than that.

       The owner, 2026-10-19: "we dont need to give them too much detail just
       that their order is ready". So there is no list of what is in the box,
       no price, no link to anything: a customer who reads the first line on a
       phone notification has already had the whole message.

       THE NUMBER IS THE ORDER'S, not the work order sheet's. It is the number
       on their confirmation email and in My Account > Your Orders, so they can
       match it without ringing to ask what a W/O is. The shop's own W/O number
       is on the paperwork at this end.

       noupdate, because the owner may reword this and a module update must not
       put his words back to mine. -->
  <data noupdate="1">
    <record id="mail_template_order_ready" model="mail.template">
      <field name="name">Order ready for pickup</field>
      <field name="model_id" ref="stock.model_stock_picking"/>
      <field name="subject">Your order {{ object._dispatch_order_name() }} is ready</field>
      <field name="email_from">{{ object._dispatch_ready_email_from() }}</field>
      <field name="reply_to">{{ object._dispatch_ready_email_from() }}</field>
      <field name="partner_to">{{ object.partner_id.id }}</field>
      <field name="auto_delete" eval="False"/>
      <field name="body_html" type="html">
        <div style="font-family: Arial, Helvetica, sans-serif; font-size: 15px; color: #111;">
          <p>
            Your order <strong t-out="object._dispatch_order_name()">S00040</strong>
            is ready for pickup<t t-if="object._dispatch_pickup_place()">
            at <t t-out="object._dispatch_pickup_place()">Medley</t></t>.
          </p>
          <p t-if="object.company_id.phone">
            Any questions, call us on <t t-out="object.company_id.phone">+1 786-238-7640</t>.
          </p>
          <p>
            Thank you,<br/>
            <t t-out="object.company_id.name">AA Impact Garage Door Supply</t>
          </p>
        </div>
      </field>
    </record>
  </data>

</odoo>
