<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- noupdate, so the owner can reword this in Settings > Technical > Email
       Templates and keep their wording through the next deploy. -->
  <data noupdate="1">

    <record id="mail_template_confirm_email" model="mail.template">
      <field name="name">Website: confirm your email address</field>
      <field name="model_id" ref="base.model_res_users"/>
      <field name="subject">Confirm your email address</field>
      <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
      <field name="email_to">{{ object.login }}</field>
      <field name="lang">{{ object.lang }}</field>
      <field name="auto_delete" eval="True"/>
      <field name="body_html" type="html">
        <div style="margin: 0px; padding: 0px; font-size: 14px;">
          <p>
            Hello <t t-out="object.name or ''">Customer</t>,
          </p>
          <p>
            An account was created at
            <t t-out="object.company_id.name or ''">AA Impact Garage Door Supply</t>
            with this email address. Please confirm it so you can sign in.
          </p>
          <div style="margin: 16px 0px;">
            <a t-att-href="object._aa_verification_url()"
               style="background-color:#714B67; padding:10px 16px; text-decoration:none; color:#fff; border-radius:5px;">
              Confirm my email
            </a>
          </div>
          <p>
            The link works once and expires in three days. If you did not
            create this account you can ignore this message - nothing was
            done with your address.
          </p>
          <p>
            Thank you,<br/>
            <t t-out="object.company_id.name or ''">AA Impact Garage Door Supply</t>
          </p>
        </div>
      </field>
    </record>

  </data>
</odoo>
