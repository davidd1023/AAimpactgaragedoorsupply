        <div class="spring-engineering">

            <!-- CURRENT SETUP -->

            <div class="se-section-title">
                CURRENT SETUP
            </div>


            <!-- ASSEMBLY -->

            <div class="se-row">

                <span>Assembly</span>

                <select
                    t-on-change="selectAssembly"
                    class="se-select">

                    <option value="Single">Single</option>
                    <option value="Duplex">Duplex</option>
                    <option value="Triplex">Triplex</option>

                </select>

            </div>


            <!-- SPRINGS -->

            <div class="se-row">

                <span>Springs</span>

                <div class="se-buttons">

                    <button
                        data-value="1"
                        t-att-class="state.springs === 1 ? 'selected' : ''"
                        t-on-click="selectSprings">
                        1
                    </button>

                    <button
                        data-value="2"
                        t-att-class="state.springs === 2 ? 'selected' : ''"
                        t-on-click="selectSprings">
                        2
                    </button>

                    <button
                        data-value="3"
                        t-att-class="state.springs === 3 ? 'selected' : ''"
