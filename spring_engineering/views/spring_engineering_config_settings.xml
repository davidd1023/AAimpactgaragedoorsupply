<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The spring price lives in Website's settings because the calculator is a
         website page. Anchored after the Website app's own General block,
         which is where someone looking for a setting about the site would
         already be. -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.spring.engineering</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_info_settings']" position="after">
                <block title="Spring Calculator" id="spring_engineering_settings">
                    <setting string="Spring sell price per pound"
                             help="What a pound of finished spring is sold for, labor included. Not marked up. Charged on every spring, from the weights the calculator shows. Cones and filler are added on top at cost plus the markup.">
                        <div class="content-group">
                            <div class="mt16">
                                <field name="spring_steel_per_lb" class="oe_inline"/>
                                <span class="ms-1">per lb</span>
                            </div>
                        </div>
                    </setting>
                </block>
                <!-- A RULE OF THE SHOP, so it gets its own block rather than
                     sitting under the calculator's heading. Per website, which
                     is why it is hidden until one is selected: the field is
                     stored on the website record and there would be nothing
                     to write to. -->
                <block title="Shop Rules" id="aa_shop_rules"
                       invisible="not website_id">
                    <setting string="Maximum per item"
                             help="The most of any one product a customer may put in an order. What they ask for beyond it is not added, and the page tells them why. Counts each product separately, so a cart may hold this many of several different things. Zero means no limit.">
                        <div class="content-group">
                            <div class="mt16">
                                <field name="aa_maximum_line_quantity" class="oe_inline"/>
                                <span class="ms-1">of any one product</span>
                            </div>
                        </div>
                    </setting>
                    <setting string="Minimum order"
                             help="The smallest order this website will accept. A cart worth less can still be filled and changed, but the checkout button stays disabled and the cart shows how much more is needed. Counts the goods before tax and ignores delivery. Zero means no minimum.">
                        <div class="content-group">
                            <div class="mt16">
                                <field name="aa_minimum_order_amount" class="oe_inline"/>
                                <span class="ms-1">before tax, excluding delivery</span>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
