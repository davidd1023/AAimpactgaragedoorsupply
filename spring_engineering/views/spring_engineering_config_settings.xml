<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The markup lives in Website's settings because the calculator is a
         website page. Anchored after the Website app's own General block,
         which is where someone looking for a setting about the site would
         already be. -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.spring.engineering</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_info_settings']" position="after">
                <block title="Spring Calculator" id="spring_engineering_settings">
                    <setting string="Assembly markup"
                             help="Added to the supplier cost of a custom spring assembly to reach the price quoted on the calculator and charged in the cart. The visitor is never shown this figure.">
                        <div class="content-group">
                            <div class="mt16">
                                <field name="spring_markup_percent" class="oe_inline"/>
                                <span class="ms-1">%</span>
                            </div>
                        </div>
                    </setting>
                    <setting string="Steel cost per pound"
                             help="What a pound of finished spring costs us, before the markup. Charged on every spring in the assembly, from the weights the calculator shows.">
                        <div class="content-group">
                            <div class="mt16">
                                <field name="spring_steel_per_lb" class="oe_inline"/>
                                <span class="ms-1">per lb</span>
                            </div>
                        </div>
                    </setting>
                    <setting string="Assembly labour"
                             help="Flat charge added to every assembly for building it, on top of the marked-up materials. Per assembly, not per spring, and added after the markup. It is not shown to the visitor as a line of its own.">
                        <div class="content-group">
                            <div class="mt16">
                                <field name="spring_labor_flat" class="oe_inline"/>
                                <span class="ms-1">per assembly</span>
                            </div>
                        </div>
                    </setting>
                </block>
                <!-- A RULE OF THE SHOP, so it gets its own block rather than
                     sitting under the calculator's heading. Per website, which
                     is why it is hidden until one is selected: the field is
                     stored on the website record and there would be nothing
                     to write to. -->
                <block title="Shop Rules" id="aa_shop_rules"
                       invisible="not website_id">
                    <setting string="Minimum order"
                             help="The smallest order this website will accept. A cart worth less can still be filled and changed, but the checkout button stays disabled and the cart shows how much more is needed. Counts the goods before tax and ignores delivery. Zero means no minimum.">
                        <div class="content-group">
                            <div class="mt16">
                                <field name="aa_minimum_order_amount" class="oe_inline"/>
                                <span class="ms-1">before tax, excluding delivery</span>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
